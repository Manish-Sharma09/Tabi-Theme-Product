{%- comment -%}
  ANNOUNCEMENT BAR V2. Version: Good Earth layout, 2026-10-03.

  The coloured strip above the header, after goodearth.in: a pause button
  ringed by a countdown on the left, messages that take turns in the middle
  (each slides up and out as the next slides in), one link on the right.

  Its own section in the header group, so it can be hidden, moved or given
  more messages in the theme editor without touching the header. Each
  message is a block. The header (sections/header.liquid) reads
  --tabi-strip-h, set here, to size the home banner under both bars.
{%- endcomment -%}

{{ 'announcement-bar-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-bar-v2.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  assign shown = 0
  for block in messages
    if block.settings.text != blank
      assign shown = shown | plus: 1
    endif
  endfor

  assign aside_link = section.settings.aside_link | default: settings.social_instagram_link
  assign show_aside = false
  if section.settings.aside_label != blank and aside_link != blank
    assign show_aside = true
  endif

  assign rotate = false
  if section.settings.autoplay and shown > 1
    assign rotate = true
  endif
-%}

{%- style -%}
  :root {
    --tabi-strip-h: {% if section.settings.show_on_mobile %}40px{% else %}0px{% endif %};
  }

  @media screen and (min-width: 990px) {
    :root {
      --tabi-strip-h: 40px;
    }
  }

  #shopify-section-{{ section.id }} {
    --tabi-strip-bg: {{ section.settings.background }};
    --tabi-strip-ink: {{ section.settings.text_color }};
    --tabi-strip-size: {{ section.settings.text_size }}px;
    --tabi-strip-interval: {{ section.settings.speed }}s;
  }
{%- endstyle -%}

{%- if shown > 0 or show_aside -%}
  <tabi-announcements
    class="tabi-strip{% unless section.settings.show_on_mobile %} tabi-strip--desktop-only{% endunless %}"
    data-interval="{{ section.settings.speed | times: 1000 }}"
    {% if rotate %}
      data-autoplay
    {% endif %}
  >
    <div class="tabi-strip__inner">
      {%- if rotate -%}
        <button
          type="button"
          class="tabi-strip__toggle"
          aria-pressed="false"
          data-label-pause="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
          data-label-play="{{ 'sections.slideshow.play_slideshow' | t | escape }}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
        >
          <svg class="tabi-strip__ring" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
            <circle class="tabi-strip__ring-track" cx="14" cy="14" r="12.5" />
            <circle class="tabi-strip__ring-progress" cx="14" cy="14" r="12.5" pathLength="100" />
          </svg>
          {% render 'tabi-icon', icon: 'pause' %}
          {% render 'tabi-icon', icon: 'play' %}
        </button>
      {%- endif -%}

      <div
        class="tabi-strip__messages"
        role="region"
        aria-label="{{ 'sections.announcements.announcement_bar' | t | escape }}"
      >
        {%- assign strip_index = 0 -%}
        {%- for block in messages -%}
          {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          <p
            class="tabi-strip__message{% if strip_index == 0 %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.text | escape }}</span>
            {%- if block.settings.link != blank and block.settings.link_label != blank %}
              <a href="{{ block.settings.link }}" class="tabi-strip__link">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </p>
          {%- assign strip_index = strip_index | plus: 1 -%}
        {%- endfor -%}
      </div>

      {%- if show_aside -%}
        {%- liquid
          assign aside_external = false
          if aside_link contains '://'
            unless aside_link contains request.host
              assign aside_external = true
            endunless
          endif
        -%}
        <a
          href="{{ aside_link }}"
          class="tabi-strip__aside"
          {% if aside_external %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {%- if section.settings.aside_icon -%}
            {% render 'tabi-icon', icon: 'mail' %}
          {%- endif -%}
          <span>{{ section.settings.aside_label | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  </tabi-announcements>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar v2",
  "tag": "section",
  "class": "announcement-bar-v2-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Messages are blocks: add, reorder or hide them below. With two or more, they take turns and a pause button with a countdown ring appears."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate messages",
      "default": true,
      "info": "Off: only the first message shows."
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Time per message",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Right-hand link"
    },
    {
      "type": "text",
      "id": "aside_label",
      "label": "Text",
      "default": "Be in the know",
      "info": "Desktop only. Leave empty to hide."
    },
    {
      "type": "url",
      "id": "aside_link",
      "label": "Link",
      "info": "Leave empty to use the Instagram link from Theme settings > Social media."
    },
    {
      "type": "checkbox",
      "id": "aside_icon",
      "label": "Show envelope icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New here? Get 10% off with code FIRST10"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link text",
          "default": "Shop Now",
          "info": "Underlined after the message. Needs a link too."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar v2",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "New here? Get 10% off with code FIRST10",
            "link_label": "Shop Now"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Sustainable. Natural. Handcrafted.",
            "link_label": "Explore Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
