    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "t:sections.header.settings.sticky_header_type.options__1.label"
        },
        {
          "value": "on-scroll-up",
          "label": "t:sections.header.settings.sticky_header_type.options__2.label"
        },
        {
          "value": "always",
          "label": "t:sections.header.settings.sticky_header_type.options__3.label"
        }
      ],
      "default": "on-scroll-up",
      "label": "t:sections.header.settings.sticky_header_type.label"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Background",
      "default": "#f9f7f4"
    },
    {
      "type": "range",
      "id": "header_opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background opacity",
      "default": 55,
      "info": "Below 100% the bar is frosted glass: the page shows through it, blurred. 100% is solid."
    },
    {
      "type": "checkbox",
      "id": "overlay_home_banner",
      "label": "Lay the header over the home page banner",
      "default": true,
      "info": "The banner then fills the whole screen, with the bar floating on it."
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Text and icons",
      "default": "#14284a"
    },
    {
      "type": "range",
      "id": "header_height_desktop",
      "min": 60,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Height on desktop",
      "default": 68
    },
    {
      "type": "range",
      "id": "header_height_mobile",
      "min": 48,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Height on mobile",
      "default": 60
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Search and cart popup colours",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Mobile menu"
    },
    {
      "type": "checkbox",
      "id": "drawer_show_search",
      "label": "Show search field",
      "default": false,
      "info": "Search is already in the bar on every page."
    },
    {
      "type": "text",
      "id": "drawer_search_placeholder",
      "label": "Search placeholder",
      "default": "Search for products…"
