          "id": "link_image"
        },
        {
          "label": "Title",
          "type": "text",
          "id": "link_title"
        },
        {
          "label": "Link",
          "type": "url",
          "id": "link_url"
        }
      ]
    }
  ]
}
{% endschema %}
