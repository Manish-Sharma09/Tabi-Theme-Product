{%- comment -%}
  THE HEADER. Version: Good Earth layout, 2026-10-03.

  Laid out after goodearth.in, with the store's own logo, menu and
  collections:
  - a coloured announcement strip: a pause button ringed by a countdown on
    the left, rotating messages in the middle, one link on the right;
  - a cream bar: logo on the left, the menu centred, search / currency /
    account / bag on the right; on a phone, menu button - logo - search, bag;
  - desktop dropdowns that span the screen: a column per child link (its
    children listed under it), then a divider, then picture cards;
  - on a phone, a menu that slides in under the bar. Tapping a link with
    children slides its own panel in from the right (Back, title, view-all),
    with + / - rows for the next level down and the picture cards below.

  Rewritten in place rather than added as a new section, because the store's
  header group points at the `header` type and section-group JSON, like
  templates/*.json, does not reliably reach this store on a push (see
  PDP-REDESIGN.md, "Third round"). Every setting therefore carries a default
  that produces the reviewed design with nothing filled in.

  What other code expects from this section, and why each is still here:
  - `.section-header` (the schema class) - custom-fixes.css stacking, the
    predictive search's height calculation, and Dawn's sticky classes.
  - `.header-wrapper` - localization-form.js and details-disclosure.js read
    `preventHide` from it, and the search modal positions itself against it.
  - `<sticky-header>` - product-page.css offsets the sticky gallery by the
    `--header-height` it sets, and media-gallery.js sends it
    `preventHeaderReveal`.
  - `#cart-icon-bubble` - the cart drawer opens from it and every cart script
    re-renders its contents from sections/cart-icon-bubble.liquid.
{%- endcomment -%}

{{ 'tabi-header.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
{%- comment -%}
  Not used by this header any more, but Dawn only ever loaded these two from
  here: the collection and search filter drawer (snippets/facets.liquid) is a
  <menu-drawer> and takes its scrim from component-menu-drawer.css.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
{%- if settings.cart_type == 'notification' -%}
  <link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'tabi-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign menu = section.settings.menu
  assign sticky_type = section.settings.sticky_header_type | default: 'none'

  comment
    The logo is the theme's own (Theme settings > Logo), drawn at this
    section's own widths - one for desktop, one for phones - so it can carry
    the weight the reference site's logo has in its bar. The text wordmark is
    only an alternative; it is also what shows if no logo has been uploaded.
  endcomment
  assign logo_image = settings.logo
  assign logo_w = section.settings.logo_width_desktop | default: 120
  assign logo_w_mobile = section.settings.logo_width_mobile | default: 100
  assign use_logo_image = false
  if section.settings.logo_style != 'text' and logo_image != blank
    assign use_logo_image = true
  endif
  assign wordmark = section.settings.logo_text | default: shop.name

  if request.page_type == 'index'
    assign logo_tag = 'h1'
  else
    assign logo_tag = 'div'
  endif

  comment
    Announcement strip: up to three messages, each with an optional
    underlined link after it. Blank messages are skipped.
  endcomment
  assign strip_count = 0
  if section.settings.announcement_1 != blank
    assign strip_count = strip_count | plus: 1
  endif
  if section.settings.announcement_2 != blank
    assign strip_count = strip_count | plus: 1
  endif
  if section.settings.announcement_3 != blank
    assign strip_count = strip_count | plus: 1
  endif

  assign aside_link = section.settings.announcement_aside_link | default: settings.social_instagram_link
  assign show_strip = false
  if section.settings.show_announcement
    if strip_count > 0 or section.settings.announcement_aside_label != blank
      assign show_strip = true
    endif
  endif

  assign card_limit = section.settings.menu_images_limit
  assign card_caption = section.settings.menu_image_caption

  if sticky_type == 'none'
    assign wrapper_tag = 'div'
  else
    assign wrapper_tag = 'sticky-header'
  endif

  assign account_url = routes.account_login_url
  if customer
    assign account_url = routes.account_url
  endif
-%}

{%- style -%}
  :root {
    --tabi-bar-h: {{ section.settings.header_height_mobile }}px;
    --tabi-strip-h: {% if show_strip %}40px{% else %}0px{% endif %};
    {%- comment -%}
      The home banner fills the rest of the screen under the header, so it
      needs the whole header's height: the strip plus the bar.
    {%- endcomment %}
    --tabi-header-h: calc(var(--tabi-bar-h) + var(--tabi-strip-h));
  }

  @media screen and (min-width: 990px) {
    :root {
      --tabi-bar-h: {{ section.settings.header_height_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --tabi-cream: {{ section.settings.header_background }};
    --tabi-ink: {{ section.settings.header_text }};
    --tabi-accent: {{ section.settings.header_accent }};
    --tabi-strip-bg: {{ section.settings.announcement_background }};
    --tabi-strip-ink: {{ section.settings.announcement_text }};
    --tabi-logo-width: {{ logo_w_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} {
      --tabi-logo-width: {{ logo_w }}px;
    }
  }
{%- endstyle -%}

{%- capture logo_markup -%}
  {%- if use_logo_image -%}
    {%- liquid
      assign logo_alt = logo_image.alt | default: shop.name | escape
      assign logo_h = logo_w | divided_by: logo_image.aspect_ratio | round
      assign logo_sizes = '(min-width: 990px) ' | append: logo_w | append: 'px, ' | append: logo_w_mobile | append: 'px'
    -%}
    {%- capture logo_widths -%}{{ logo_w_mobile }}, {{ logo_w }}, {{ logo_w | times: 1.5 | round }}, {{ logo_w | times: 2 }}, {{ logo_w | times: 3 }}{%- endcapture -%}
    {{
      logo_image
      | image_url: width: 600
      | image_tag:
        class: 'tabi-header__logo-img',
        widths: logo_widths,
        sizes: logo_sizes,
        width: logo_w,
        height: logo_h,
        alt: logo_alt,
        loading: 'eager',
        preload: true
    }}
  {%- else -%}
    <span class="tabi-wordmark" translate="no">{{ wordmark | escape }}</span>
  {%- endif -%}
{%- endcapture -%}

<{{ wrapper_tag }}
  class="header-wrapper tabi-header-wrapper color-{{ section.settings.color_scheme }}"
  {% if sticky_type != 'none' %}
    data-sticky-type="{{ sticky_type }}"
  {% endif %}
>
  {%- if show_strip -%}
    <tabi-announcements
      class="tabi-strip"
      data-interval="{{ section.settings.announcement_speed | times: 1000 }}"
      style="--tabi-strip-interval: {{ section.settings.announcement_speed }}s;"
    >
      <div class="tabi-strip__inner">
        {%- if strip_count > 1 -%}
          <button
            type="button"
            class="tabi-strip__toggle"
            aria-pressed="false"
            data-label-pause="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
            data-label-play="{{ 'sections.slideshow.play_slideshow' | t | escape }}"
            aria-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
          >
            <svg class="tabi-strip__ring" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
              <circle class="tabi-strip__ring-track" cx="14" cy="14" r="12.5" />
              <circle class="tabi-strip__ring-progress" cx="14" cy="14" r="12.5" pathLength="100" />
            </svg>
            {% render 'tabi-icon', icon: 'pause' %}
            {% render 'tabi-icon', icon: 'play' %}
          </button>
        {%- endif -%}

        <div
          class="tabi-strip__messages"
          role="region"
          aria-label="{{ 'sections.announcements.announcement_bar' | t | escape }}"
        >
          {%- assign strip_index = 0 -%}
          {%- for i in (1..3) -%}
            {%- liquid
              assign text_key = 'announcement_' | append: i
              assign label_key = 'announcement_' | append: i | append: '_link_label'
              assign link_key = 'announcement_' | append: i | append: '_link'
              assign message = section.settings[text_key]
              assign message_label = section.settings[label_key]
              assign message_link = section.settings[link_key]
            -%}
            {%- if message == blank -%}{%- continue -%}{%- endif -%}
            <p class="tabi-strip__message{% if strip_index == 0 %} is-active{% endif %}">
              <span>{{ message | escape }}</span>
              {%- if message_link != blank and message_label != blank %}
                <a href="{{ message_link }}" class="tabi-strip__link">{{ message_label | escape }}</a>
              {%- endif -%}
            </p>
            {%- assign strip_index = strip_index | plus: 1 -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.announcement_aside_label != blank and aside_link != blank -%}
          {%- liquid
            assign aside_external = false
            if aside_link contains '://'
              unless aside_link contains request.host
                assign aside_external = true
              endunless
            endif
          -%}
          <a
            href="{{ aside_link }}"
            class="tabi-strip__aside"
            {% if aside_external %}
              target="_blank" rel="noopener"
            {% endif %}
          >
            {% render 'tabi-icon', icon: 'mail' %}
            <span>{{ section.settings.announcement_aside_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </tabi-announcements>
  {%- endif -%}

  <header class="tabi-header">
    <div class="tabi-header__bar">
      {%- if menu != blank -%}
        <button
          type="button"
          class="tabi-header__icon tabi-header__menu-button"
          aria-label="{{ 'sections.header.menu' | t }}"
          aria-expanded="false"
          aria-controls="TabiDrawer-{{ section.id }}"
        >
          {% render 'tabi-icon', icon: 'menu' %}
          {% render 'tabi-icon', icon: 'close' %}
        </button>
      {%- endif -%}

      <{{ logo_tag }} class="tabi-header__logo">
        <a href="{{ routes.root_url }}" class="tabi-header__logo-link">{{ logo_markup }}</a>
      </{{ logo_tag }}>

      {%- if menu != blank -%}
        <tabi-nav class="tabi-nav{% if section.settings.show_dropdown_arrows %} tabi-nav--arrows{% endif %}">
          <nav aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="tabi-nav__list" role="list">
              {%- for link in menu.links -%}
                {%- liquid
                  comment
                    Columns this link's dropdown needs: one per child that has
                    children of its own, and one for each run of childless
                    children, which stack as headings in a single column.
                  endcomment
                  assign cols = 0
                  assign in_leaves = false
                  for childlink in link.links
                    if childlink.links != blank
                      assign cols = cols | plus: 1
                      assign in_leaves = false
                    elsif in_leaves == false
                      assign cols = cols | plus: 1
                      assign in_leaves = true
                    endif
                  endfor

                  comment
                    The dropdown is a six-column grid, as on the reference site;
                    cards fill whatever the link columns leave, so none ever
                    wraps onto a second row.
                  endcomment
                  assign mega_limit = 6 | minus: cols | at_most: card_limit | at_least: 0
                  assign card_start = cols | plus: 1
                -%}
                {%- capture mega_cards -%}
                  {%- if mega_limit > 0 -%}
                    {%- render 'tabi-menu-cards',
                      link: link,
                      blocks: section.blocks,
                      limit: mega_limit,
                      caption: card_caption,
                      variant: 'mega',
                      start: card_start
                    -%}
                  {%- endif -%}
                {%- endcapture -%}
                {%- liquid
                  assign has_panel = false
                  if link.links != blank or mega_cards != blank
                    assign has_panel = true
                  endif
                -%}
                <li
                  class="tabi-nav__item{% if has_panel %} tabi-nav__item--parent{% endif %}"
                  {% if has_panel %}
                    data-tabi-nav-item
                  {% endif %}
                >
                  <span class="tabi-nav__trigger">
                    <a
                      href="{{ link.url }}"
                      class="tabi-nav__link{% if link.active or link.child_active %} is-active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                    {%- if has_panel -%}
                      <button
                        type="button"
                        class="tabi-nav__toggle"
                        aria-expanded="false"
                        aria-controls="TabiNavPanel-{{ section.id }}-{{ forloop.index }}"
                      >
                        <span class="visually-hidden">{{ link.title | escape }}</span>
                        {% render 'tabi-icon', icon: 'chevron-down' %}
                      </button>
                    {%- endif -%}
                  </span>

                  {%- if has_panel -%}
                    <div id="TabiNavPanel-{{ section.id }}-{{ forloop.index }}" class="tabi-mega">
                      <div class="tabi-mega__grid">
                        {%- comment -%}
                          Childless links collect into one column of headings
                          until a link with children starts a column of its own.
                        {%- endcomment -%}
                        {%- assign leaf_html = '' -%}
                        {%- for childlink in link.links -%}
                          {%- if childlink.links != blank -%}
                            {%- if leaf_html != blank -%}
                              <div class="tabi-mega__col tabi-mega__col--headings">{{ leaf_html }}</div>
                              {%- assign leaf_html = '' -%}
                            {%- endif -%}
                            <div class="tabi-mega__col">
                              <a
                                href="{{ childlink.url }}"
                                class="tabi-mega__heading"
                                {% if childlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{- childlink.title | escape -}}
                              </a>
                              <ul class="tabi-mega__list" role="list">
                                {%- for grandchildlink in childlink.links -%}
                                  <li>
                                    <a
                                      href="{{ grandchildlink.url }}"
                                      class="tabi-mega__link"
                                      {% if grandchildlink.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      {{- grandchildlink.title | escape -}}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- else -%}
                            {%- capture leaf_one -%}
                              <a
                                href="{{ childlink.url }}"
                                class="tabi-mega__heading"
                                {% if childlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{- childlink.title | escape -}}
                              </a>
                            {%- endcapture -%}
                            {%- assign leaf_html = leaf_html | append: leaf_one -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if leaf_html != blank -%}
                          <div class="tabi-mega__col tabi-mega__col--headings">{{ leaf_html }}</div>
                        {%- endif -%}

                        {{ mega_cards }}
                      </div>
                    </div>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </tabi-nav>
      {%- endif -%}

      <div class="tabi-header__icons">
        {% render 'header-search', input_id: 'Search-In-Modal-Desktop', tabi_icons: true, tabi_label: section.settings.show_search_label %}

        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          <div class="tabi-header__country header-localization">
            <localization-form data-prevent-hide>
              {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'HeaderCountry', compact: 'currency' -%}
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ account_url }}" class="tabi-header__icon tabi-header__icon--account">
            {% render 'tabi-icon', icon: 'account' %}
            <span class="visually-hidden">
              {%- liquid
                if customer
                  echo 'customer.account_fallback' | t
                else
                  echo 'customer.log_in' | t
                endif
              -%}
            </span>
          </a>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%}
          Razorpay Magic Checkout's sidecart takes over this link: its script
          (snippets/magicSidecartScript.liquid) catches clicks on
          a[href='/cart'] / .icon-cart before the theme's cart drawer sees
          them. Keep the href and the classes. header__icon--cart is the old
          header's class, kept for scripts that look for it.
        {%- endcomment -%}
        <a href="{{ routes.cart_url }}" class="tabi-header__icon tabi-header__icon--cart header__icon--cart" id="cart-icon-bubble">
          {%- render 'tabi-cart-icon' -%}
        </a>
      </div>
    </div>
  </header>

  {%- if menu != blank -%}
    {%- liquid
      assign show_account = false
      if section.settings.drawer_show_account and shop.customer_accounts_enabled
        assign show_account = true
      endif
      assign show_currency = false
      if section.settings.drawer_show_localization and localization.available_countries.size > 1
        assign show_currency = true
      endif
      assign drawer_menu = section.settings.drawer_menu
    -%}
    <tabi-drawer id="TabiDrawer-{{ section.id }}" class="tabi-drawer">
      <span class="tabi-drawer__backdrop" data-tabi-drawer-close></span>
      <div
        class="tabi-drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-label="{{ 'sections.header.menu' | t }}"
        tabindex="-1"
      >
        {%- comment -%} Level 1: the top-level links, then account, extra links and currency. {%- endcomment -%}
        <div class="tabi-drawer__pane tabi-drawer__pane--root is-current" tabindex="-1">
          <nav class="tabi-drawer__nav" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="tabi-drawer__list" role="list">
              {%- for link in menu.links -%}
                <li class="tabi-drawer__item" style="--tabi-i: {{ forloop.index0 }};">
                  {%- if link.links != blank -%}
                    <button
                      type="button"
                      class="tabi-drawer__row{% if link.active or link.child_active %} is-active{% endif %}"
                      aria-expanded="false"
                      aria-controls="TabiDrawerPane-{{ section.id }}-{{ forloop.index }}"
                      data-tabi-pane-open
                    >
                      <span>{{ link.title | escape }}</span>
                      {% render 'tabi-icon', icon: 'chevron-right' %}
                    </button>
                  {%- else -%}
                    <a
                      href="{{ link.url }}"
                      class="tabi-drawer__row{% if link.active %} is-active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span>{{ link.title | escape }}</span>
                      {% render 'tabi-icon', icon: 'chevron-right' %}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>

          {%- if show_account or drawer_menu != blank or show_currency -%}
            <div class="tabi-drawer__lower">
              <ul class="tabi-drawer__lower-list" role="list">
                {%- if show_account -%}
                  <li>
                    <a href="{{ account_url }}" class="tabi-drawer__lower-link tabi-drawer__lower-link--account">
                      {%- liquid
                        if customer
                          echo 'customer.account_fallback' | t
                        else
                          echo 'customer.log_in' | t
                        endif
                      -%}
                    </a>
                  </li>
                {%- endif -%}

                {%- for extra in drawer_menu.links -%}
                  <li>
                    <a
                      href="{{ extra.url }}"
                      class="tabi-drawer__lower-link"
                      {% if extra.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- extra.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}

                {%- if show_currency -%}
                  <li class="tabi-drawer__currency">
                    {%- comment -%}
                      A plain localization form: each country is a submit button
                      carrying its own country_code, so picking one needs no
                      script. Dawn's <localization-form> is not used here - its
                      list is a popover, and this one opens in place like the
                      rows above it.
                    {%- endcomment -%}
                    {%- form 'localization', id: 'TabiDrawerCurrencyForm', class: 'tabi-drawer__currency-form' -%}
                      <button
                        type="button"
                        class="tabi-drawer__lower-link tabi-drawer__trigger"
                        aria-expanded="false"
                        aria-controls="TabiDrawerCurrency-{{ section.id }}"
                      >
                        <span>
                          {{- section.settings.drawer_currency_label | escape }}:
                          {{ localization.country.currency.iso_code }}
                          ({{ localization.country.currency.symbol }})
                        </span>
                        {% render 'tabi-icon', icon: 'plus' %}
                      </button>
                      <div class="tabi-drawer__sub" id="TabiDrawerCurrency-{{ section.id }}">
                        <div class="tabi-drawer__sub-inner">
                          {%- if localization.available_countries.size > 9 -%}
                            <input
                              type="search"
                              class="tabi-drawer__country-filter"
                              placeholder="{{ 'localization.search' | t }}"
                              aria-label="{{ 'localization.search' | t }}"
                              autocomplete="off"
                              autocorrect="off"
                              autocapitalize="off"
                              spellcheck="false"
                              data-tabi-country-filter
                            >
                          {%- endif -%}
                          <ul class="tabi-drawer__countries" role="list">
                            {%- for country in localization.available_countries -%}
                              <li>
                                <button
                                  type="submit"
                                  name="country_code"
                                  value="{{ country.iso_code }}"
                                  class="tabi-drawer__country"
                                  {% if country.iso_code == localization.country.iso_code %}
                                    aria-current="true"
                                  {% endif %}
                                >
                                  <span class="tabi-drawer__country-name">{{ country.name }}</span>
                                  <span class="tabi-drawer__country-currency">
                                    {{- country.currency.iso_code }}
                                    {{ country.currency.symbol -}}
                                  </span>
                                </button>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    {%- endform -%}
                  </li>
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Level 2: one panel per top-level link that has children. {%- endcomment -%}
        {%- for link in menu.links -%}
          {%- if link.links == blank -%}{%- continue -%}{%- endif -%}
          {%- assign pane_index = forloop.index -%}
          <div
            class="tabi-drawer__pane tabi-drawer__pane--sub"
            id="TabiDrawerPane-{{ section.id }}-{{ pane_index }}"
            tabindex="-1"
          >
            <div class="tabi-drawer__pane-head">
              <button type="button" class="tabi-drawer__back" data-tabi-pane-back>
                {% render 'tabi-icon', icon: 'chevron-left' %}
                <span>{{ section.settings.drawer_back_label | escape }}</span>
              </button>
              <a href="{{ link.url }}" class="tabi-drawer__pane-title">{{ link.title | escape }}</a>
              <a href="{{ link.url }}" class="tabi-drawer__view-all">
                {% render 'tabi-icon', icon: 'chevrons-right' %}
                <span class="visually-hidden">
                  {{- 'sections.collection_list.view_all' | t }}
                  {{ link.title | escape -}}
                </span>
              </a>
            </div>

            <ul class="tabi-drawer__groups" role="list">
              {%- for childlink in link.links -%}
                <li class="tabi-drawer__group-item">
                  {%- if childlink.links != blank -%}
                    <button
                      type="button"
                      class="tabi-drawer__group tabi-drawer__trigger"
                      aria-expanded="false"
                      aria-controls="TabiDrawerSub-{{ section.id }}-{{ pane_index }}-{{ forloop.index }}"
                    >
                      <span>{{ childlink.title | escape }}</span>
                      {% render 'tabi-icon', icon: 'plus' %}
                    </button>
                    <div class="tabi-drawer__sub" id="TabiDrawerSub-{{ section.id }}-{{ pane_index }}-{{ forloop.index }}">
                      <div class="tabi-drawer__sub-inner">
                        <ul class="tabi-drawer__sublist" role="list">
                          <li>
                            <a href="{{ childlink.url }}" class="tabi-drawer__sublink">
                              {{- 'sections.collection_list.view_all' | t -}}
                            </a>
                          </li>
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                href="{{ grandchildlink.url }}"
                                class="tabi-drawer__sublink"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{- grandchildlink.title | escape -}}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </div>
                  {%- else -%}
                    <a
                      href="{{ childlink.url }}"
                      class="tabi-drawer__group"
                      {% if childlink.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- childlink.title | escape -}}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- capture drawer_cards -%}
              {%- render 'tabi-menu-cards',
                link: link,
                blocks: section.blocks,
                limit: card_limit,
                caption: card_caption,
                variant: 'drawer'
              -%}
            {%- endcapture -%}
            {%- if drawer_cards != blank -%}
              <div class="tabi-drawer__cards">{{ drawer_cards }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </tabi-drawer>
  {%- endif -%}
</{{ wrapper_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.querySelector('tabi-nav')?.closeAll?.();
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      if (this.searchModal) this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}


