{%- comment -%}
  THE HEADER.

  Built to the reviewed header mockup: wordmark left, the menu centred, search /
  account / bag right on desktop; menu button, centred wordmark, search and bag
  on a phone, with the menu itself in a drawer that slides in from the left.

  Rewritten in place rather than added as a new section, because the store's
  header group points at the `header` type and section-group JSON, like
  templates/*.json, does not reliably reach this store on a push (see
  PDP-REDESIGN.md, "Third round"). Every new setting therefore carries a
  default that produces the reviewed design with nothing filled in.

  What other code expects from this section, and why each is still here:
  - `.section-header` (the schema class) - custom-fixes.css stacking, the
    predictive search's height calculation, and Dawn's sticky classes.
  - `.header-wrapper` - localization-form.js and details-disclosure.js read
    `preventHide` from it, and the search modal positions itself against it.
  - `<sticky-header>` - product-page.css offsets the sticky gallery by the
    `--header-height` it sets, and media-gallery.js sends it
    `preventHeaderReveal`.
  - `#cart-icon-bubble` - the cart drawer opens from it and every cart script
    re-renders its contents from sections/cart-icon-bubble.liquid.
{%- endcomment -%}

{{ 'tabi-header.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
{%- comment -%}
  Not used by this header any more, but Dawn only ever loaded these two from
  here: the collection and search filter drawer (snippets/facets.liquid) is a
  <menu-drawer> and takes its scrim from component-menu-drawer.css.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
{%- if settings.cart_type == 'notification' -%}
  <link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'tabi-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign menu = section.settings.menu
  assign sticky_type = section.settings.sticky_header_type | default: 'none'

  comment
    The logo is the theme's own (Theme settings > Logo), at the theme's own
    width, exactly as the previous header drew it. The text wordmark is only
    an alternative; it is also what shows if no logo has been uploaded.
  endcomment
  assign logo_image = settings.logo
  assign logo_w = settings.logo_width | default: 90
  assign use_logo_image = false
  if section.settings.logo_style != 'text' and logo_image != blank
    assign use_logo_image = true
  endif
  assign wordmark = section.settings.logo_text | default: shop.name

  if request.page_type == 'index'
    assign logo_tag = 'h1'
  else
    assign logo_tag = 'div'
  endif

-%}

{%- style -%}
  :root {
    --tabi-header-h: {{ section.settings.header_height_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    :root {
      --tabi-header-h: {{ section.settings.header_height_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --tabi-cream: {{ section.settings.header_background }};
    --tabi-ink: {{ section.settings.header_text }};
    --tabi-logo-width: {{ logo_w }}px;
    --tabi-glass-opacity: {{ section.settings.header_opacity }}%;
  }

  {%- comment -%}
    On the home page the bar lies over the cover photograph instead of
    pushing it down: the negative margin lets the next section start at the
    very top, under the glass. --tabi-header-overlap tells the home hero to
    fill the whole screen and to centre its copy below the bar.
  {%- endcomment -%}
  {%- if request.page_type == 'index' and section.settings.overlay_home_banner %}
    #shopify-section-{{ section.id }} {
      margin-bottom: calc(-1 * var(--tabi-header-h));
    }

    :root {
      --tabi-header-overlap: var(--tabi-header-h);
    }
  {%- endif %}
{%- endstyle -%}

{%- capture logo_markup -%}
  {%- if use_logo_image -%}
    {%- liquid
      assign logo_alt = logo_image.alt | default: shop.name | escape
      assign logo_h = logo_w | divided_by: logo_image.aspect_ratio | round
      assign logo_sizes = logo_w | append: 'px'
    -%}
    {%- capture logo_widths -%}{{ logo_w }}, {{ logo_w | times: 1.5 | round }}, {{ logo_w | times: 2 }}, {{ logo_w | times: 3 }}{%- endcapture -%}
    {{
      logo_image
      | image_url: width: 600
      | image_tag:
        class: 'tabi-header__logo-img',
        widths: logo_widths,
        sizes: logo_sizes,
        width: logo_w,
        height: logo_h,
        alt: logo_alt,
        loading: 'eager',
        preload: true
    }}
  {%- else -%}
    <span class="tabi-wordmark" translate="no">{{ wordmark | escape }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  if sticky_type == 'none'
    assign wrapper_tag = 'div'
  else
    assign wrapper_tag = 'sticky-header'
  endif
-%}

<{{ wrapper_tag }}
  class="header-wrapper tabi-header-wrapper color-{{ section.settings.color_scheme }}"
  {% if sticky_type != 'none' %}
    data-sticky-type="{{ sticky_type }}"
  {% endif %}
>
  <header class="tabi-header">
    <div class="tabi-header__bar">
      {%- if menu != blank -%}
        <button
          type="button"
          class="tabi-header__icon tabi-header__menu-button"
          aria-label="{{ 'sections.header.menu' | t }}"
          aria-expanded="false"
          aria-controls="TabiDrawer-{{ section.id }}"
        >
          {% render 'tabi-icon', icon: 'menu' %}
        </button>
      {%- endif -%}

      <{{ logo_tag }} class="tabi-header__logo">
        <a href="{{ routes.root_url }}" class="tabi-header__logo-link">{{ logo_markup }}</a>
      </{{ logo_tag }}>

      {%- if menu != blank -%}
        <tabi-nav class="tabi-nav{% if section.settings.show_dropdown_arrows %} tabi-nav--arrows{% endif %}">
          <nav aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="tabi-nav__list" role="list">
              {%- for link in menu.links -%}
                {%- liquid
                  assign card_count = 0
                  for block in section.blocks
                    if block.type == 'menu-image' and block.settings.link_name == link.title
                      assign card_count = card_count | plus: 1
                    endif
                  endfor
                  assign has_panel = false
                  if link.links != blank or card_count > 0
                    assign has_panel = true
                  endif
                  assign is_mega = false
                  if link.levels > 1
                    assign is_mega = true
                  endif
                -%}
                <li
                  class="tabi-nav__item{% if has_panel %} tabi-nav__item--parent{% endif %}{% if is_mega %} tabi-nav__item--mega{% endif %}"
                  {% if has_panel %}
                    data-tabi-nav-item
                  {% endif %}
                >
                  <span class="tabi-nav__trigger">
                    <a
                      href="{{ link.url }}"
                      class="tabi-nav__link{% if link.active or link.child_active %} is-active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span class="tabi-nav__label">{{ link.title | escape }}</span>
                    </a>
                    {%- if has_panel -%}
                      <button
                        type="button"
                        class="tabi-nav__toggle"
                        aria-expanded="false"
                        aria-controls="TabiNavPanel-{{ section.id }}-{{ forloop.index }}"
                      >
                        <span class="visually-hidden">{{ link.title | escape }}</span>
                        {% render 'tabi-icon', icon: 'chevron-down' %}
                      </button>
                    {%- endif -%}
                  </span>

                  {%- if has_panel -%}
                    <div
                      id="TabiNavPanel-{{ section.id }}-{{ forloop.index }}"
                      class="tabi-nav__panel{% if is_mega %} tabi-nav__panel--mega{% endif %}"
                    >
                      <div class="tabi-nav__panel-inner">
                        {%- if is_mega -%}
                          <div class="tabi-nav__columns">
                            {%- for childlink in link.links -%}
                              <div class="tabi-nav__column">
                                <a
                                  href="{{ childlink.url }}"
                                  class="tabi-nav__column-title"
                                  {% if childlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{- childlink.title | escape -}}
                                </a>
                                {%- if childlink.links != blank -%}
                                  <ul class="tabi-nav__sublist" role="list">
                                    {%- for grandchildlink in childlink.links -%}
                                      <li>
                                        <a
                                          href="{{ grandchildlink.url }}"
                                          class="tabi-nav__sublink"
                                          {% if grandchildlink.current %}
                                            aria-current="page"
                                          {% endif %}
                                        >
                                          {{- grandchildlink.title | escape -}}
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </div>
                            {%- endfor -%}
                          </div>
                        {%- elsif link.links != blank -%}
                          <ul class="tabi-nav__sublist" role="list">
                            {%- for childlink in link.links -%}
                              <li>
                                <a
                                  href="{{ childlink.url }}"
                                  class="tabi-nav__sublink"
                                  {% if childlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{- childlink.title | escape -}}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}

                        {%- for card in section.blocks -%}
                          {%- unless card.type == 'menu-image' and card.settings.link_name == link.title -%}
                            {%- continue -%}
                          {%- endunless -%}
                          <a href="{{ card.settings.link_url }}" class="tabi-nav__card" {{ card.shopify_attributes }}>
                            {%- if card.settings.link_image != blank -%}
                              {{
                                card.settings.link_image
                                | image_url: width: 640
                                | image_tag:
                                  class: 'tabi-nav__card-img',
                                  widths: '320, 480, 640',
                                  sizes: '240px',
                                  loading: 'lazy'
                              }}
                            {%- endif -%}
                            {%- if card.settings.link_title != blank -%}
                              <span class="tabi-nav__card-title">{{ card.settings.link_title | escape }}</span>
                            {%- endif -%}
                          </a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </tabi-nav>
      {%- endif -%}

      <div class="tabi-header__icons">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="tabi-header__localization" data-prevent-hide>
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {% render 'header-search', input_id: 'Search-In-Modal-Desktop', tabi_icons: true %}

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="tabi-header__icon tabi-header__icon--account"
          >
            {% render 'tabi-icon', icon: 'account' %}
            <span class="visually-hidden">
              {%- liquid
                if customer
                  echo 'customer.account_fallback' | t
                else
                  echo 'customer.log_in' | t
                endif
              -%}
            </span>
          </a>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%}
          Razorpay Magic Checkout's sidecart takes over this link: its script
          (snippets/magicSidecartScript.liquid) catches clicks on
          a[href='/cart'] / .icon-cart before the theme's cart drawer sees
          them. Keep the href and the classes. header__icon--cart is the old
          header's class, kept for scripts that look for it.
        {%- endcomment -%}
        <a href="{{ routes.cart_url }}" class="tabi-header__icon tabi-header__icon--cart header__icon--cart" id="cart-icon-bubble">
          {%- render 'tabi-cart-icon' -%}
        </a>
      </div>
    </div>
  </header>

  {%- if menu != blank -%}
    <tabi-drawer id="TabiDrawer-{{ section.id }}" class="tabi-drawer">
      <dialog class="tabi-drawer__dialog" aria-label="{{ 'sections.header.menu' | t }}">
        <span class="tabi-drawer__backdrop" data-tabi-drawer-close></span>
        <div class="tabi-drawer__panel" tabindex="-1">
          {%- comment -%}
            Account and currency sit beside the close button as icons, as on
            the reference site, rather than in a footer of their own: a
            footer pinned to the bottom of the panel took a third of a small
            phone's height and cut off the last menu rows.
          {%- endcomment -%}
          <div class="tabi-drawer__head">
            <a href="{{ routes.root_url }}" class="tabi-drawer__logo">{{ logo_markup }}</a>
            <div class="tabi-drawer__tools">
              {%- if section.settings.drawer_show_localization and localization.available_countries.size > 1 -%}
                <div class="tabi-drawer__localization header-localization">
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{- 'localization.country_label' | t -}}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile', compact: true -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                </div>
              {%- endif -%}

              {%- if section.settings.drawer_show_account and shop.customer_accounts_enabled -%}
                <a
                  href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                  class="tabi-header__icon tabi-drawer__account"
                >
                  {% render 'tabi-icon', icon: 'account' %}
                  <span class="visually-hidden">
                    {%- liquid
                      if customer
                        echo 'customer.account_fallback' | t
                      else
                        echo 'customer.log_in' | t
                      endif
                    -%}
                  </span>
                </a>
              {%- endif -%}

              <button
                type="button"
                class="tabi-header__icon tabi-drawer__close"
                aria-label="{{ 'accessibility.close' | t }}"
                data-tabi-drawer-close
              >
                {% render 'tabi-icon', icon: 'close' %}
              </button>
            </div>
          </div>

          <div class="tabi-drawer__body">
            {%- if section.settings.drawer_show_search -%}
            <form action="{{ routes.search_url }}" method="get" role="search" class="tabi-drawer__search">
              <label for="TabiDrawerSearch-{{ section.id }}" class="visually-hidden">
                {{- 'general.search.search' | t -}}
              </label>
              {% render 'tabi-icon', icon: 'search' %}
              <input
                id="TabiDrawerSearch-{{ section.id }}"
                class="tabi-drawer__search-input"
                type="search"
                name="q"
                placeholder="{{ section.settings.drawer_search_placeholder | escape }}"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                enterkeyhint="search"
              >
              <input type="hidden" name="options[prefix]" value="last">
            </form>
            {%- endif -%}

            <nav class="tabi-drawer__nav" aria-label="{{ 'sections.header.menu' | t }}">
              <ul class="tabi-drawer__list" role="list">
                {%- for link in menu.links -%}
                  <li class="tabi-drawer__item" style="--tabi-i: {{ forloop.index0 }};">
                    {%- if link.links != blank -%}
                      <button
                        type="button"
                        class="tabi-drawer__link tabi-drawer__trigger"
                        aria-expanded="false"
                        aria-controls="TabiDrawerSub-{{ section.id }}-{{ forloop.index }}"
                      >
                        <span>{{ link.title | escape }}</span>
                        {% render 'tabi-icon', icon: 'plus' %}
                      </button>
                      <div class="tabi-drawer__sub" id="TabiDrawerSub-{{ section.id }}-{{ forloop.index }}">
                        <div class="tabi-drawer__sub-inner">
                          <ul class="tabi-drawer__sublist" role="list">
                            {%- for childlink in link.links -%}
                              <li class="tabi-drawer__subitem">
                                {%- if childlink.links != blank -%}
                                  {%- assign child_id = forloop.index -%}
                                  <button
                                    type="button"
                                    class="tabi-drawer__sublink tabi-drawer__trigger"
                                    aria-expanded="false"
                                    aria-controls="TabiDrawerSub-{{ section.id }}-{{ forloop.parentloop.index }}-{{ child_id }}"
                                  >
                                    <span>{{ childlink.title | escape }}</span>
                                    {% render 'tabi-icon', icon: 'plus' %}
                                  </button>
                                  <div
                                    class="tabi-drawer__sub"
                                    id="TabiDrawerSub-{{ section.id }}-{{ forloop.parentloop.index }}-{{ child_id }}"
                                  >
                                    <div class="tabi-drawer__sub-inner">
                                      <ul class="tabi-drawer__sublist tabi-drawer__sublist--deep" role="list">
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              href="{{ grandchildlink.url }}"
                                              class="tabi-drawer__sublink"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {{- grandchildlink.title | escape -}}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </div>
                                {%- else -%}
                                  <a
                                    href="{{ childlink.url }}"
                                    class="tabi-drawer__sublink"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{- childlink.title | escape -}}
                                  </a>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    {%- else -%}
                      <a
                        href="{{ link.url }}"
                        class="tabi-drawer__link"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- link.title | escape -}}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </nav>

            {%- if section.settings.drawer_show_localization and localization.available_languages.size > 1 -%}
              <div class="tabi-drawer__localization tabi-drawer__localization--language header-localization">
                <localization-form>
                  {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                    <div>
                      <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                        {{- 'localization.language_label' | t -}}
                      </h2>
                      {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                    </div>
                  {%- endform -%}
                </localization-form>
              </div>
            {%- endif -%}

            {%- if section.settings.drawer_tagline != blank -%}
              <p class="tabi-drawer__tagline">{{ section.settings.drawer_tagline | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      </dialog>
    </tabi-drawer>
  {%- endif -%}
</{{ wrapper_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.querySelector('tabi-nav')?.closeAll?.();
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      if (this.searchModal) this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo style",
      "options": [
        { "value": "image", "label": "Logo image" },
        { "value": "text", "label": "Text wordmark" }
      ],
      "default": "image",
      "info": "Logo image uses the logo and width set in Theme settings > Logo, as before."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Wordmark",
      "default": "tabi",
      "info": "Only used when Logo style is Text wordmark, or when no logo is uploaded."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label",
      "info": "Top-level links show in the bar. A link with sub-links opens a dropdown on desktop and an expanding row in the mobile menu. To give a link a dropdown, nest links under it in Content > Menus."
    },
    {
      "type": "checkbox",
      "id": "show_dropdown_arrows",
      "label": "Show dropdown arrows on desktop",
      "default": true,
