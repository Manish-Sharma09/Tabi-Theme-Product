{%- comment -%}
  HOME CARDS - an optional ornament, heading and line of text, then picture
  cards with an underlined caption under each, as a centred grid or as a
  carousel.

  One section for three blocks of the reference site's home page
  (goodearth.in, 2026-10-10), which differ only in settings:
  - "Delightful Decor": carousel, four in view, white;
  - "Dressed in Celebration": three cards, the middle one larger and arched;
  - "Indulgent Rituals": four cards on a coloured band.
  The theme editor offers each as its own preset.

  A card's picture, first match wins: the card's own picture; the
  collection's picture; the first product picture in the collection that no
  earlier card on this section already shows (two collections often open on
  the same product). Caption and link fall back to the collection's title
  and address.

  2026-10-10, second pass: the ornament defaults to Tabi's illustrated
  flower sprig and the cards rise in a short cascade on scroll
  (assets/tabi-motion.*). Decorations beside the heading (the reference's
  clouds) are "Decoration" blocks, drawn by snippets/home-decorations; the
  card loop skips them.
{%- endcomment -%}

{{ 'home-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign layout = section.settings.layout
  assign cols = section.settings.columns_desktop
  assign cards = section.blocks | where: 'type', 'card'
  assign heading = section.settings.heading | strip

  comment
    Where the cards come from: the Card blocks, the products of one
    collection, or one card per collection in a list. A source left empty
    falls back to the blocks, so the row is never blank while it is set up.
  endcomment
  assign source = section.settings.source | default: 'blocks'
  assign source_collection = section.settings.source_collection
  assign source_collections = section.settings.source_collections
  if source == 'products' and source_collection == blank
    assign source = 'blocks'
  endif
  if source == 'collections' and source_collections == blank
    assign source = 'blocks'
  endif

  case source
    when 'products'
      assign card_count = source_collection.products_count | at_most: section.settings.product_limit
    when 'collections'
      assign card_count = source_collections.size
    else
      assign card_count = cards.size
  endcase

  assign visible_mobile = section.settings.carousel_mobile | default: '2.5' | times: 1.0

  assign feature_index = 0
  if layout == 'grid' and section.settings.feature_middle and card_count == 3
    assign feature_index = 2
  endif

  case section.settings.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'tall'
      assign ratio = '2 / 3'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '3 / 4'
  endcase

  comment
    Rendered widths for the sizes attribute, in the reference's 1434px
    layout: assets/home-sections.css part 4 and 5.
  endcomment
  if layout == 'carousel'
    assign card_px = 1248 | divided_by: cols | minus: 16
  else
    case cols
      when 2
        assign card_px = 420
      when 3
        assign card_px = 309
      when 5
        assign card_px = 244
      when 6
        assign card_px = 200
      else
        assign card_px = 303
    endcase
  endif
  assign card_vw = card_px | times: 100 | divided_by: 1434 | plus: 1
  assign card_cap = card_px | plus: 2

  if layout == 'carousel'
    assign mobile_vw = 96 | divided_by: visible_mobile | ceil
  else
    assign mobile_cols = section.settings.columns_mobile | times: 1
    assign mobile_vw = 88 | divided_by: mobile_cols | ceil
  endif

  assign card_sizes = '(min-width: 1440px) ' | append: card_cap | append: 'px, (min-width: 750px) ' | append: card_vw | append: 'vw, ' | append: mobile_vw | append: 'vw'
  assign feature_sizes = '(min-width: 1440px) 346px, (min-width: 750px) 25vw, 78vw'

  assign show_header = false
  if section.settings.show_ornament or heading != blank or section.settings.text != blank
    assign show_header = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .home-section {
    --home-bg: {{ section.settings.background }};
    --home-heading: {{ section.settings.heading_color }};
    --home-text: {{ section.settings.text_color }};
    --home-link: {{ section.settings.link_color }};
    --home-ornament: {{ section.settings.ornament_color }};
    --home-pattern: {{ section.settings.pattern_color }};
    --home-pattern-opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
    --home-heading-size: {{ section.settings.heading_size }};
    --home-pt: {{ section.settings.padding_top }};
    --home-pb: {{ section.settings.padding_bottom }};
    --home-pt-m: {{ section.settings.padding_top_mobile }};
    --home-pb-m: {{ section.settings.padding_bottom_mobile }};
    --home-ratio: {{ ratio }};
    --home-fit: {{ section.settings.fit }};
  }
{%- endstyle -%}

{%- if layout == 'carousel' -%}
  <script src="{{ 'home-sections.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  class="home-section home-cards home-cards--{{ layout }} home-cards--cols-{{ cols }} home-cards--mobile-{{ section.settings.columns_mobile }}{% if section.settings.fit == 'contain' %} home-cards--fit{% endif %}{% if section.settings.shape == 'arch' %} home-cards--arch{% endif %}{% if section.settings.pattern %} home-section--pattern{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  {%- if section.settings.background_image != blank -%}
    {{
      section.settings.background_image
      | image_url: width: 2400
      | image_tag:
        class: 'home-section__bg',
        widths: '750, 1100, 1500, 1920, 2400',
        sizes: '100vw',
        alt: '',
        loading: 'lazy'
    }}
  {%- endif -%}

  {% render 'home-decorations', blocks: section.blocks %}

  <div class="home-section__inner">
    {%- if show_header -%}
      <div class="home-cards__header">
        {%- if section.settings.show_ornament -%}
          {%- if section.settings.ornament_image != blank -%}
            {{
              section.settings.ornament_image
              | image_url: width: 400
              | image_tag: class: 'home-ornament home-ornament--image', alt: '', loading: 'lazy'
            }}
          {%- else -%}
            {% render 'home-ornament', style: section.settings.ornament_style %}
          {%- endif -%}
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="home-heading" id="HomeCards-{{ section.id }}" data-reveal="rise" style="--reveal-order: 1;">
            {{- heading | escape | newline_to_br -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="home-text home-cards__sub" data-reveal="rise" style="--reveal-order: 2;">
            {{- section.settings.text -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <div class="home-cards__body">
        {%- capture cards_html -%}
          {%- assign used = '|' -%}
          {%- case source -%}
            {%- when 'products' -%}
              {%- for product in source_collection.products limit: section.settings.product_limit -%}
                {%- liquid
                  assign is_feature = false
                  assign sizes = card_sizes
                  if forloop.index == feature_index
                    assign is_feature = true
                    assign sizes = feature_sizes
                  endif
                  assign price = ''
                  if section.settings.show_price
                    assign price = product.price | money
                  endif
                -%}
                {% render 'home-card',
                  image: product.featured_image,
                  caption: product.title,
                  url: product.url,
                  price: price,
                  sizes: sizes,
                  layout: layout,
                  is_feature: is_feature,
                  index: forloop.index0
                %}
              {%- endfor -%}

            {%- when 'collections' -%}
              {%- for card_collection in source_collections -%}
                {%- liquid
                  assign card_image = card_collection.image
                  if card_image == blank
                    for product in card_collection.products limit: 8
                      if product.featured_image != blank
                        assign key = '|' | append: product.featured_image.src | append: '|'
                        unless used contains key
                          assign card_image = product.featured_image
                          break
                        endunless
                      endif
                    endfor
                  endif
                  if card_image != blank
                    assign used = used | append: card_image.src | append: '|'
                  endif

                  assign is_feature = false
                  assign sizes = card_sizes
                  if forloop.index == feature_index
                    assign is_feature = true
                    assign sizes = feature_sizes
                  endif
                -%}
                {% render 'home-card',
                  image: card_image,
                  caption: card_collection.title,
                  url: card_collection.url,
                  sizes: sizes,
                  layout: layout,
                  is_feature: is_feature,
                  index: forloop.index0
                %}
              {%- endfor -%}

            {%- else -%}
              {%- for block in cards -%}
                {%- liquid
                  assign card_collection = block.settings.collection
                  assign card_image = block.settings.image

                  if card_image == blank and card_collection != blank
                    if card_collection.image != blank
                      assign card_image = card_collection.image
                    else
                      for product in card_collection.products limit: 8
                        if product.featured_image != blank
                          assign key = '|' | append: product.featured_image.src | append: '|'
                          unless used contains key
                            assign card_image = product.featured_image
                            break
                          endunless
                        endif
                      endfor
                      if card_image == blank
                        assign card_image = card_collection.featured_image
                      endif
                    endif
                  endif

                  if card_image != blank
                    assign used = used | append: card_image.src | append: '|'
                  endif

                  assign caption = block.settings.caption | strip | default: card_collection.title
                  assign card_url = block.settings.link | default: card_collection.url

                  assign is_feature = false
                  assign sizes = card_sizes
                  if forloop.index == feature_index
                    assign is_feature = true
                    assign sizes = feature_sizes
                  endif
                -%}
                {% render 'home-card',
                  image: card_image,
                  caption: caption,
                  url: card_url,
                  sizes: sizes,
                  layout: layout,
                  is_feature: is_feature,
                  index: forloop.index0,
                  attributes: block.shopify_attributes
                %}
              {%- endfor -%}
          {%- endcase -%}
        {%- endcapture -%}

        {%- if layout == 'carousel' -%}
          <home-carousel
            class="home-carousel home-carousel--phone-{{ section.settings.mobile_controls | default: 'both' }}"
            style="--home-visible: {{ cols }}; --home-visible-m: {{ visible_mobile }};"
            role="region"
            aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
            {% if heading != blank %}
              aria-labelledby="HomeCards-{{ section.id }}"
            {% else %}
              aria-label="{{ 'sections.slideshow.carousel' | t }}"
            {% endif %}
          >
            <ul class="home-carousel__track" role="list">
              {{- cards_html -}}
            </ul>
            {%- comment -%}
              Desktop: the arrows sit outside the row's ends. Phones: arrows
              and dots share one row under the cards (assets/home-sections.css).
            {%- endcomment -%}
            <div class="home-carousel__controls">
              <button
                type="button"
                class="home-carousel__arrow home-carousel__arrow--prev"
                aria-label="{{ 'general.slider.previous_slide' | t }}"
                data-carousel-prev
              >
                {% render 'tabi-icon', icon: 'chevron-left' %}
              </button>
              <span
                class="home-carousel__dots"
                data-label="{{ 'sections.slideshow.load_slide' | t | escape }}"
                data-of="{{ 'general.slider.of' | t | escape }}"
              ></span>
              <button
                type="button"
                class="home-carousel__arrow home-carousel__arrow--next"
                aria-label="{{ 'general.slider.next_slide' | t }}"
                data-carousel-next
              >
                {% render 'tabi-icon', icon: 'chevron-right' %}
              </button>
            </div>
          </home-carousel>
        {%- else -%}
          <ul class="home-cards__grid" role="list">
            {{- cards_html -}}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Home: Picture cards",
  "tag": "section",
  "class": "home-cards-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Cards come from",
      "options": [
        {
          "value": "blocks",
          "label": "Cards I add below"
        },
        {
          "value": "products",
          "label": "Products in a collection"
        },
        {
          "value": "collections",
          "label": "A card for each collection"
        }
      ],
      "default": "blocks",
      "info": "Products: every product in the collection you pick, newest order as set on the collection. Collections: one card per collection in your list, with its picture and title."
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Collection",
      "info": "For \"Products in a collection\". Create or edit it under Products > Collections."
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Number of products",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": false
    },
    {
      "type": "collection_list",
      "id": "source_collections",
      "label": "Collections",
      "limit": 12,
      "info": "For \"A card for each collection\"."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Cards in a row on desktop",
      "default": 4,
      "info": "For the carousel, how many are in view at once."
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards in a row on phones (grid)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "carousel_mobile",
      "label": "Cards in view on phones (carousel)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "1.5",
          "label": "1 and a half"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "2.5",
          "label": "2 and a half"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2.5"
    },
    {
      "type": "select",
      "id": "mobile_controls",
      "label": "Carousel buttons on phones",
      "options": [
        {
          "value": "both",
          "label": "Arrows and dots"
        },
        {
          "value": "arrows",
          "label": "Arrows"
        },
        {
          "value": "dots",
          "label": "Dots"
        }
      ],
      "default": "both"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Picture shape",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "portrait_tall",
          "label": "Portrait 3:4"
        },
        {
          "value": "tall",
          "label": "Tall 2:3"
        },
        {
          "value": "landscape",
          "label": "Landscape 4:3"
        }
      ],
      "default": "portrait_tall"
    },
    {
      "type": "select",
      "id": "fit",
      "label": "Picture fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill the card"
        },
        {
          "value": "contain",
          "label": "Show the whole picture"
        }
      ],
      "default": "cover",
      "info": "\"Show the whole picture\" suits products photographed on white."
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Card top",
      "options": [
        {
          "value": "square",
          "label": "Square corners"
        },
        {
          "value": "arch",
          "label": "Arched"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "feature_middle",
      "label": "Larger, arched middle card",
      "default": false,
      "info": "Grid with exactly three cards. On phones the middle card leads, on a row of its own."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_ornament",
      "label": "Show ornament",
      "default": false
    },
    {
      "type": "select",
      "id": "ornament_style",
      "label": "Ornament style",
      "options": [
        {
          "value": "sprig",
          "label": "Illustrated flower sprig"
        },
        {
          "value": "drawn",
          "label": "Block-print flowers"
        }
      ],
      "default": "sprig"
    },
    {
      "type": "image_picker",
      "id": "ornament_image",
      "label": "Ornament picture",
      "info": "Optional. Replaces the style above. About 350 x 90."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the Home"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hand block printed linen for every table and every corner of your home.</p>"
    },
    {
      "type": "header",
      "content": "Colours and background"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background picture",
      "info": "Optional. Covers the whole section, under the pattern."
    },
    {
      "type": "checkbox",
      "id": "pattern",
      "label": "Block-print pattern",
      "default": false
    },
    {
      "type": "color",
      "id": "pattern_color",
      "label": "Pattern",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "min": 2,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Pattern strength",
      "default": 8
    },
    {
      "type": "color",
      "id": "ornament_color",
      "label": "Ornament",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4d4d4f"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Captions",
      "default": "#4d4d4f"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "The heading and cards rise into place, one after another, the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Size and spacing"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 36,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above on phones",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below on phones",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "paragraph",
          "content": "Shown when \"Cards come from\" is set to \"Cards I add below\"."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Gives the card its link, caption and, with no picture below, a product picture from the collection."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "info": "Optional when a collection is chosen."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Leave empty to use the collection's title."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to use the collection."
        }
      ]
    },
    {
