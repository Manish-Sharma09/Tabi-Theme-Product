{%- comment -%}
  HOME FEATURE - a picture and a short story beside it: heading, text,
  underlined link. On phones the story comes first and the picture runs the
  full width under it.

  Built after the reference site's "The Gift of Good Earth" block
  (goodearth.in, 2026-10-10); measurements and the phone layout are in
  assets/home-sections.css, part 3.

  2026-10-24: the cut-out picture over the corner and the "Decoration"
  blocks (illustrations) were removed with their settings, at the client's
  request. The story's alignment (left, centre, right) is a setting, with
  its own value for phones. The picture and text rise into view on scroll
  (assets/tabi-motion.*).
{%- endcomment -%}

{{ 'home-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = section.settings.heading | strip

  comment
    Eager only when this is the first section; under the hero it is below
    the fold and would compete with the hero picture for bandwidth.
  endcomment
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .home-section {
    --home-bg: {{ section.settings.background }};
    --home-heading: {{ section.settings.heading_color }};
    --home-text: {{ section.settings.text_color }};
    --home-link: {{ section.settings.link_color }};
    --home-heading-size: {{ section.settings.heading_size }};
    --home-align: {{ section.settings.text_align | default: 'left' }};
    --home-link-weight: {{ section.settings.link_weight }};
    --home-align-m: {{ section.settings.text_align_mobile | default: 'left' }};
    --home-pt: {{ section.settings.padding_top }};
    --home-pb: {{ section.settings.padding_bottom }};
    --home-pt-m: {{ section.settings.padding_top_mobile }};
    --home-pb-m: {{ section.settings.padding_bottom_mobile }};
  }
{%- endstyle -%}

<div
  class="home-section home-feature{% if section.settings.image_position == 'right' %} home-feature--reverse{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  <div class="home-section__inner home-feature__inner">
    <div class="home-feature__media" data-reveal="rise">
      {%- capture main_picture -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 1440px) 593px, (min-width: 750px) 42vw, 84vw',
              loading: loading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'home-placeholder' }}
        {%- endif -%}
      {%- endcapture -%}

      {%- comment -%}
        The picture repeats the story's link for pointer users; keyboard and
        screen reader users get the one link under the text.
      {%- endcomment -%}
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="home-feature__main" tabindex="-1" aria-hidden="true">
          {{- main_picture -}}
        </a>
      {%- else -%}
        <span class="home-feature__main">{{ main_picture }}</span>
      {%- endif -%}
    </div>

    <div class="home-feature__copy">
      {%- if heading != blank -%}
        <h2 class="home-heading" data-reveal="rise" style="--reveal-order: 1;">
          {{- heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="home-text home-feature__text" data-reveal="rise" style="--reveal-order: 2;">
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <p class="home-feature__actions" data-reveal="rise" style="--reveal-order: 3;">
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="home-link">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- else -%}
            <span class="home-link">{{ section.settings.link_label | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home: Feature story",
  "tag": "section",
  "class": "home-feature-section",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Picture",
      "options": [
        {
          "value": "left",
          "label": "Left of the story"
        },
        {
          "value": "right",
          "label": "Right of the story"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture",
      "info": "Shown about 600 x 520 on desktop and the full width of the screen on phones. Set a focal point so the crop keeps the subject."
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift of Tabi",
      "info": "Each new line starts a new line on the page."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hand block printed table linen, tea cosies and keepsakes for little ones, made in small batches and packed without plastic.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Explore gifting"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The picture links here too."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "Heading, text and link, on desktop."
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment on phones",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "The picture and text rise into place the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Colours and size"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4d4d4f"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#4d4d4f"
    },
    {
      "type": "select",
      "id": "link_weight",
      "label": "Link weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 36,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 50,
      "info": "Phones use a little over half."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 58
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 58
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above on phones",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below on phones",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Home: Feature story"
    }
  ]
}
{% endschema %}
