{%- comment -%}
  HOME FEATURE - a picture with a second, cut-out picture laid over its lower
  corner, and a short story beside it: heading, text, underlined link.

  Built after the reference site's "The Gift of Good Earth" block
  (goodearth.in, 2026-10-10); measurements and the phone layout are in
  assets/home-sections.css, part 3.

  Decorations (the reference's cloud, butterfly and ribbon) are "Decoration"
  blocks, drawn by snippets/home-decorations: any number, each one of Tabi's
  illustrations or an uploaded picture, placed and sized in the editor. The
  preset starts with the cotton spray in the top corner and the linen ribbon
  under the story. The pieces enter on scroll (assets/tabi-motion.*).
{%- endcomment -%}

{{ 'home-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = section.settings.heading | strip
  assign has_cutout = false
  if section.settings.cutout != blank
    assign has_cutout = true
  endif

  comment
    Eager only when this is the first section; under the hero it is below
    the fold and would compete with the hero picture for bandwidth.
  endcomment
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .home-section {
    --home-bg: {{ section.settings.background }};
    --home-heading: {{ section.settings.heading_color }};
    --home-text: {{ section.settings.text_color }};
    --home-link: {{ section.settings.link_color }};
    --home-heading-size: {{ section.settings.heading_size }};
    --home-pt: {{ section.settings.padding_top }};
    --home-pb: {{ section.settings.padding_bottom }};
  }
{%- endstyle -%}

<div
  class="home-section home-feature{% if has_cutout %} home-feature--has-cutout{% endif %}{% if section.settings.image_position == 'right' %} home-feature--reverse{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  {% render 'home-decorations', blocks: section.blocks %}

  <div class="home-section__inner home-feature__inner">
    <div class="home-feature__media" data-reveal="rise">
      {%- capture main_picture -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 1440px) 593px, (min-width: 750px) 42vw, 63vw',
              loading: loading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'home-placeholder' }}
        {%- endif -%}
      {%- endcapture -%}

      {%- comment -%}
        The picture repeats the story's link for pointer users; keyboard and
        screen reader users get the one link under the text.
      {%- endcomment -%}
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="home-feature__main" tabindex="-1" aria-hidden="true">
          {{- main_picture -}}
        </a>
      {%- else -%}
        <span class="home-feature__main">{{ main_picture }}</span>
      {%- endif -%}

      {%- if has_cutout -%}
        <span class="home-feature__cutout" data-reveal="rise" style="--reveal-order: 3;">
          {{
            section.settings.cutout
            | image_url: width: 900
            | image_tag:
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 1440px) 316px, (min-width: 750px) 22vw, 41vw',
              loading: loading
          }}
        </span>
      {%- endif -%}
    </div>

    <div class="home-feature__copy">
      {%- if heading != blank -%}
        <h2 class="home-heading" data-reveal="rise" style="--reveal-order: 1;">
          {{- heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="home-text home-feature__text" data-reveal="rise" style="--reveal-order: 2;">
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <p class="home-feature__actions" data-reveal="rise" style="--reveal-order: 3;">
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="home-link">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- else -%}
            <span class="home-link">{{ section.settings.link_label | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home: Feature story",
  "tag": "section",
  "class": "home-feature-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Picture",
      "options": [
        {
          "value": "left",
          "label": "Left of the story"
        },
        {
          "value": "right",
          "label": "Right of the story"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture",
      "info": "Shown about 600 x 520 on desktop. Set a focal point so the crop keeps the subject."
    },
    {
      "type": "image_picker",
      "id": "cutout",
      "label": "Cut-out picture",
      "info": "Optional. Laid over the picture's lower corner. A product on a transparent or white background looks best, about 600px wide."
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift of Tabi",
      "info": "Each new line starts a new line on the page."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hand block printed table linen, tea cosies and keepsakes for little ones, made in small batches and packed without plastic.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Explore gifting"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The picture links here too."
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "Pictures and text rise into place and the illustrations draw themselves the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Colours and size"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4d4d4f"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#4d4d4f"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 36,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 50,
      "info": "Phones use a little over half."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 58
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "decoration",
      "name": "Decoration",
      "settings": [
        {
          "type": "paragraph",
          "content": "A picture drawn behind (or in front of) this section, like the reference site's clouds and ribbons. Add as many as you like; delete the block to remove one."
        },
        {
          "type": "select",
          "id": "illustration",
          "label": "Tabi illustration",
          "options": [
            {
              "value": "spray-left",
              "label": "Cotton spray, growing right"
            },
            {
              "value": "spray-right",
              "label": "Cotton spray with bird, growing left"
            },
            {
              "value": "ribbon",
              "label": "Linen ribbon"
            },
            {
              "value": "sprig",
              "label": "Flower sprig"
            },
            {
              "value": "meadow",
              "label": "Meadow border"
            }
          ],
          "default": "spray-left"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Or your own picture",
          "info": "Replaces the illustration above. A PNG or WebP with a transparent background."
        },
        {
          "type": "header",
          "content": "Placement"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-center",
              "label": "Top centre"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "middle-left",
              "label": "Middle left"
            },
            {
              "value": "middle-right",
              "label": "Middle right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom centre"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "top-left"
        },
        {
          "type": "range",
          "id": "offset_x",
          "min": -200,
          "max": 600,
          "step": 10,
          "unit": "px",
          "label": "Distance from the side",
          "default": 0,
          "info": "At desktop size. Below zero it hangs past the edge. For the centre positions, moves it right."
        },
        {
          "type": "range",
          "id": "offset_y",
          "min": -200,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Distance from the top or bottom",
          "default": 0,
          "info": "For the middle positions, moves it down."
        },
        {
          "type": "range",
          "id": "width",
          "min": 40,
          "max": 1440,
          "step": 20,
          "unit": "px",
          "label": "Width on desktop",
          "default": 320,
          "info": "Scales down with the layout on smaller screens."
        },
        {
          "type": "range",
          "id": "width_mobile",
          "min": 0,
          "max": 400,
          "step": 5,
          "unit": "px",
          "label": "Width on phones",
          "default": 100,
          "info": "0 hides it on phones."
        },
        {
          "type": "checkbox",
          "id": "flip",
          "label": "Mirror",
          "default": false
        },
        {
          "type": "range",
          "id": "opacity",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Opacity",
          "default": 100
        },
        {
          "type": "select",
          "id": "layer",
          "label": "Layer",
          "options": [
            {
              "value": "back",
              "label": "Behind the content"
            },
            {
              "value": "front",
              "label": "In front of the content"
            }
          ],
          "default": "back"
        },
        {
          "type": "header",
          "content": "Motion"
        },
        {
          "type": "select",
          "id": "animation",
          "label": "Entrance",
          "options": [
            {
              "value": "grow",
              "label": "Grow from its corner"
            },
            {
              "value": "unroll",
              "label": "Unroll left to right"
            },
            {
              "value": "open",
              "label": "Open from the middle"
            },
            {
              "value": "rise",
              "label": "Rise from below"
            },
            {
              "value": "fade",
              "label": "Fade in"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "grow",
          "info": "Plays once, as it scrolls into view, while the section's \"Animate on scroll\" is on."
        },
        {
          "type": "range",
          "id": "drift",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Drift on scroll",
          "default": 16
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home: Feature story",
      "blocks": [
        {
          "type": "decoration",
          "settings": {
            "illustration": "spray-right",
            "position": "top-right",
            "offset_x": 0,
            "offset_y": 20,
            "width": 340,
            "width_mobile": 150,
            "flip": false,
            "opacity": 100,
            "layer": "back",
            "animation": "grow",
            "drift": 18
          }
        },
        {
          "type": "decoration",
          "settings": {
            "illustration": "ribbon",
            "position": "bottom-right",
            "offset_x": 0,
            "offset_y": 50,
            "width": 600,
            "width_mobile": 0,
            "flip": false,
            "opacity": 100,
            "layer": "back",
            "animation": "unroll",
            "drift": 10
          }
        }
      ]
    }
  ]
}
{% endschema %}
