{%- comment -%}
  HOME FEATURE - a picture with a second, cut-out picture laid over its lower
  corner, and a short story beside it: heading, text, underlined link.

  Built after the reference site's "The Gift of Good Earth" block
  (goodearth.in, 2026-10-10); measurements and the phone layout are in
  assets/home-sections.css, part 3. Up to three decorative pictures (the
  reference's cloud, butterfly and ribbon) can be added; with none, nothing
  is drawn for them.

  2026-10-10, second pass: by default the decorations are Tabi's own
  illustrations - the cotton spray with the bird in the top corner and the
  linen ribbon unrolling under the story - and the pieces enter on scroll
  (assets/tabi-motion.*). Both are settings.
{%- endcomment -%}

{{ 'home-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = section.settings.heading | strip
  assign has_cutout = false
  if section.settings.cutout != blank
    assign has_cutout = true
  endif

  assign decor_style = section.settings.decor_style
  assign has_decor = false
  if decor_style == 'tabi'
    assign has_decor = true
  elsif decor_style == 'custom'
    if section.settings.decor_1 != blank or section.settings.decor_2 != blank or section.settings.decor_3 != blank
      assign has_decor = true
    endif
  endif

  comment
    With the picture on the right the story sits left, so the spray moves to
    the left corner and grows from that side.
  endcomment
  assign spray_name = 'spray-right'
  assign spray_reveal = 'grow-right'
  if section.settings.image_position == 'right'
    assign spray_name = 'spray-left'
    assign spray_reveal = 'grow-left'
  endif

  comment
    Eager only when this is the first section; under the hero it is below
    the fold and would compete with the hero picture for bandwidth.
  endcomment
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .home-section {
    --home-bg: {{ section.settings.background }};
    --home-heading: {{ section.settings.heading_color }};
    --home-text: {{ section.settings.text_color }};
    --home-link: {{ section.settings.link_color }};
    --home-heading-size: {{ section.settings.heading_size }};
    --home-pt: {{ section.settings.padding_top }};
    --home-pb: {{ section.settings.padding_bottom }};
  }
{%- endstyle -%}

<div
  class="home-section home-feature{% if has_cutout %} home-feature--has-cutout{% endif %}{% if section.settings.image_position == 'right' %} home-feature--reverse{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  {%- if has_decor and decor_style == 'tabi' -%}
    <span class="home-decor-frame" aria-hidden="true">
      {% render 'home-decor',
        name: spray_name,
        class: 'home-decor home-decor--spray',
        reveal: spray_reveal,
        parallax: 18
      %}
      {% render 'home-decor',
        name: 'ribbon',
        class: 'home-decor home-decor--ribbon',
        reveal: 'unroll',
        parallax: 10
      %}
    </span>
  {%- elsif has_decor -%}
    <span class="home-decor-frame" aria-hidden="true">
      {%- for i in (1..3) -%}
        {%- liquid
          assign decor_key = 'decor_' | append: i
          assign decor = section.settings[decor_key]
          assign decor_class = 'home-decor home-decor--' | append: i
        -%}
        {%- if decor != blank -%}
          {{
            decor
            | image_url: width: 900
            | image_tag:
              class: decor_class,
              widths: '200, 400, 600, 900',
              sizes: '(min-width: 750px) 30vw, 42vw',
              alt: '',
              loading: 'lazy'
          }}
        {%- endif -%}
      {%- endfor -%}
    </span>
  {%- endif -%}

  <div class="home-section__inner home-feature__inner">
    <div class="home-feature__media" data-reveal="rise">
      {%- capture main_picture -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 1440px) 593px, (min-width: 750px) 42vw, 63vw',
              loading: loading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'home-placeholder' }}
        {%- endif -%}
      {%- endcapture -%}

      {%- comment -%}
        The picture repeats the story's link for pointer users; keyboard and
        screen reader users get the one link under the text.
      {%- endcomment -%}
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="home-feature__main" tabindex="-1" aria-hidden="true">
          {{- main_picture -}}
        </a>
      {%- else -%}
        <span class="home-feature__main">{{ main_picture }}</span>
      {%- endif -%}

      {%- if has_cutout -%}
        <span class="home-feature__cutout" data-reveal="rise" style="--reveal-order: 3;">
          {{
            section.settings.cutout
            | image_url: width: 900
            | image_tag:
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 1440px) 316px, (min-width: 750px) 22vw, 41vw',
              loading: loading
          }}
        </span>
      {%- endif -%}
    </div>

    <div class="home-feature__copy">
      {%- if heading != blank -%}
        <h2 class="home-heading" data-reveal="rise" style="--reveal-order: 1;">
          {{- heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="home-text home-feature__text" data-reveal="rise" style="--reveal-order: 2;">
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <p class="home-feature__actions" data-reveal="rise" style="--reveal-order: 3;">
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="home-link">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- else -%}
            <span class="home-link">{{ section.settings.link_label | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home: Feature story",
  "tag": "section",
  "class": "home-feature-section",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Picture",
      "options": [
        { "value": "left", "label": "Left of the story" },
        { "value": "right", "label": "Right of the story" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture",
      "info": "Shown about 600 x 520 on desktop. Set a focal point so the crop keeps the subject."
    },
    {
      "type": "image_picker",
      "id": "cutout",
      "label": "Cut-out picture",
      "info": "Optional. Laid over the picture's lower corner. A product on a transparent or white background looks best, about 600px wide."
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift of Tabi",
      "info": "Each new line starts a new line on the page."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hand block printed table linen, tea cosies and keepsakes for little ones, made in small batches and packed without plastic.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Explore gifting"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The picture links here too."
    },
    {
      "type": "header",
      "content": "Decorations"
    },
    {
      "type": "select",
      "id": "decor_style",
      "label": "Decorations",
      "options": [
        { "value": "tabi", "label": "Tabi illustrations" },
        { "value": "custom", "label": "My pictures below" },
        { "value": "none", "label": "None" }
      ],
      "default": "tabi",
      "info": "Tabi illustrations: the cotton spray with the bird in the top corner and the linen ribbon under the story."
    },
    {
      "type": "paragraph",
      "content": "Your own pictures, drawn behind the content like the reference site's clouds and ribbons. Use PNGs with transparent backgrounds, and choose \"My pictures below\" above."
    },
    {
      "type": "image_picker",
      "id": "decor_1",
      "label": "Top corner",
      "info": "About 300px wide on desktop, against the right edge."
    },
    {
      "type": "image_picker",
      "id": "decor_2",
      "label": "Beside the heading",
      "info": "About 90px wide."
    },
    {
      "type": "image_picker",
      "id": "decor_3",
      "label": "Lower corner",
      "info": "About 425px wide, against the right edge."
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "Pictures and text rise into place and the illustrations draw themselves the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Colours and size"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4d4d4f"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#4d4d4f"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 36,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 50,
      "info": "Phones use a little over half."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 58
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Home: Feature story"
    }
  ]
}
{% endschema %}
