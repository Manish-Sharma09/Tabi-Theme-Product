{%- comment -%}
  HOME SPOTLIGHT - a full-width coloured band, centred: ornament, heading,
  text, a wide framed picture, one line of spaced capitals and a button.

  Built after the reference site's "Visit Our Store" block (goodearth.in,
  2026-10-10), where the line of capitals lists its cities; Tabi uses it for
  the brand's three promises. Measurements are in assets/home-sections.css,
  part 7.
{%- endcomment -%}

{{ 'home-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.video != blank or section.settings.video_link != blank -%}
  <script src="{{ 'home-sections.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign heading = section.settings.heading | strip
  assign tagline = section.settings.tagline | strip

  case section.settings.mobile_ratio
    when 'portrait'
      assign mobile_ratio = '4 / 5'
    when 'landscape'
      assign mobile_ratio = '4 / 3'
    else
      assign mobile_ratio = '1 / 1'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .home-section {
    --home-bg: {{ section.settings.background }};
    --home-heading: {{ section.settings.heading_color }};
    --home-text: {{ section.settings.text_color }};
    --home-ornament: {{ section.settings.ornament_color }};
    --home-pattern: {{ section.settings.pattern_color }};
    --home-pattern-opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
    --home-button-bg: {{ section.settings.button_background }};
    --home-button-text: {{ section.settings.button_text }};
    --home-frame: {{ section.settings.frame_color }};
    --home-spot-ratio-mobile: {{ mobile_ratio }};
    --home-heading-size: {{ section.settings.heading_size }};
    --home-pt: {{ section.settings.padding_top }};
    --home-pb: {{ section.settings.padding_bottom }};
    --home-pt-m: {{ section.settings.padding_top_mobile }};
    --home-pb-m: {{ section.settings.padding_bottom_mobile }};
  }
{%- endstyle -%}

<div
  class="home-section home-spot{% if section.settings.frame %} home-spot--framed{% endif %}{% if section.settings.pattern %} home-section--pattern{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  {%- if section.settings.background_image != blank -%}
    {{
      section.settings.background_image
      | image_url: width: 2400
      | image_tag:
        class: 'home-section__bg',
        widths: '750, 1100, 1500, 1920, 2400',
        sizes: '100vw',
        alt: '',
        loading: 'lazy'
    }}
  {%- endif -%}

  {% render 'home-decorations', blocks: section.blocks %}

  <div class="home-section__inner home-spot__inner">
    {%- if section.settings.show_ornament -%}
      {%- if section.settings.ornament_image != blank -%}
        {{
          section.settings.ornament_image
          | image_url: width: 400
          | image_tag: class: 'home-ornament home-ornament--image', alt: '', loading: 'lazy'
        }}
      {%- else -%}
        {% render 'home-ornament', style: section.settings.ornament_style %}
      {%- endif -%}
    {%- endif -%}

    {%- if heading != blank -%}
      <h2 class="home-heading" data-reveal="rise" style="--reveal-order: 1;">
        {{- heading | escape | newline_to_br -}}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="home-text home-spot__text" data-reveal="rise" style="--reveal-order: 2;">
        {{- section.settings.text -}}
      </div>
    {%- endif -%}

    {%- capture spot_picture -%}
      {%- if section.settings.image != blank -%}
        {%- assign desktop = section.settings.image -%}
        {%- assign mobile = section.settings.image_mobile | default: desktop -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile | image_url: width: 500 }} 500w,
                {{ mobile | image_url: width: 750 }} 750w,
                {{ mobile | image_url: width: 1100 }} 1100w
              "
              sizes="88vw"
              width="{{ mobile.width }}"
              height="{{ mobile.height }}"
            >
          {%- endif -%}
          {{
            desktop
            | image_url: width: 2400
            | image_tag:
              widths: '500, 750, 1100, 1500, 1920, 2400',
              sizes: '(min-width: 1440px) 1160px, (min-width: 750px) 81vw, 88vw',
              loading: 'lazy'
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'home-placeholder' }}
      {%- endif -%}
    {%- endcapture -%}

    <div class="home-spot__media" data-reveal="rise" style="--reveal-order: 3;">
      {%- liquid
        assign spot_video = section.settings.video
        assign spot_link = section.settings.video_link
        assign has_video = false
        if spot_video != blank or spot_link != blank
          assign has_video = true
        endif
      -%}
      {%- if has_video -%}
        {%- comment -%}
          The picture stays underneath: it is what shows before the video
          has loaded, and for visitors who ask for less motion. The video
          plays only while on screen (home-video, assets/home-sections.js).
        {%- endcomment -%}
        <home-video class="home-video" aria-label="{{ heading | escape }}">
          {{ spot_picture }}
          {%- if spot_video != blank -%}
            {{
              spot_video
              | video_tag:
                class: 'home-video__file',
                loop: true,
                muted: true,
                playsinline: true,
                controls: false,
                preload: 'metadata',
                image_size: '1600x'
            }}
          {%- else -%}
            {%- liquid
              if spot_link.type == 'youtube'
                assign embed_src = 'https://www.youtube-nocookie.com/embed/' | append: spot_link.id | append: '?autoplay=1&mute=1&loop=1&playlist=' | append: spot_link.id | append: '&controls=0&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1&enablejsapi=1'
              else
                assign embed_src = 'https://player.vimeo.com/video/' | append: spot_link.id | append: '?background=1&autoplay=1&loop=1&muted=1&dnt=1'
              endif
            -%}
            <span
              class="home-video__embed"
              data-embed-src="{{ embed_src | escape }}"
              data-embed-type="{{ spot_link.type }}"
            ></span>
          {%- endif -%}
          <button
            type="button"
            class="home-video__toggle"
            aria-label="{{ 'sections.home_video.pause' | t }}"
            data-pause-label="{{ 'sections.home_video.pause' | t }}"
            data-play-label="{{ 'sections.home_video.play' | t }}"
            data-video-toggle
          >
            <span class="home-video__pause-icon">{% render 'tabi-icon', icon: 'pause' %}</span>
            <span class="home-video__play-icon">{% render 'tabi-icon', icon: 'play' %}</span>
          </button>
        </home-video>
      {%- elsif section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="home-spot__media-link" tabindex="-1" aria-hidden="true">
          {{- spot_picture -}}
        </a>
      {%- else -%}
        {{ spot_picture }}
      {%- endif -%}
    </div>

    {%- if tagline != blank -%}
      {%- comment -%}
        Each phrase between the bars stays on one line. Phones stack the
        phrases and drop the bars, which would otherwise start a line.
      {%- endcomment -%}
      {%- assign tagline_parts = tagline | split: '|' -%}
      <p class="home-spot__tagline" data-reveal="rise" style="--reveal-order: 4;">
        {%- assign phrase_count = 0 -%}
        {%- for part in tagline_parts -%}
          {%- assign phrase = part | strip -%}
          {%- if phrase != blank -%}
            {%- if phrase_count > 0 -%}
              <span class="home-spot__bar"> | </span>
            {%- endif -%}
            <span class="home-spot__phrase">{{ phrase | escape }}</span>
            {%- assign phrase_count = phrase_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <p class="home-spot__actions" data-reveal="rise" style="--reveal-order: 5;">
        {%- if section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="home-button">{{ section.settings.button_label | escape }}</a>
        {%- else -%}
          <span class="home-button">{{ section.settings.button_label | escape }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Home: Spotlight band",
  "tag": "section",
  "class": "home-spot-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_ornament",
      "label": "Show ornament",
      "default": true
    },
    {
      "type": "select",
      "id": "ornament_style",
      "label": "Ornament style",
      "options": [
        {
          "value": "sprig",
          "label": "Illustrated flower sprig"
        },
        {
          "value": "drawn",
          "label": "Block-print flowers"
        }
      ],
      "default": "sprig"
    },
    {
      "type": "image_picker",
      "id": "ornament_image",
      "label": "Ornament picture",
      "info": "Optional. Replaces the style above. About 350 x 90."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A Little Thread, A Lasting Story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tabi began with an appreciation of all things natural, handmade and kind to the planet. We print by hand, make in small batches and often to order, and pack without plastic.</p>"
    },
    {
      "type": "header",
      "content": "Picture"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture",
      "info": "Wide, at least 2300 x 930. Set a focal point."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile picture",
      "info": "Optional. Without one, phones crop the picture above to the shape below."
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Picture shape on phones",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "landscape",
          "label": "Landscape 4:3"
        }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "paragraph",
      "content": "Optional. A video plays silently on a loop in the frame instead of the picture, while it is on screen, with a pause button. Keep the picture: it shows while the video loads and for visitors who ask for less motion."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Uploaded to Shopify (Content > Files). Short, under 20 MB."
    },
    {
      "type": "video_url",
      "id": "video_link",
      "label": "Or a YouTube or Vimeo link",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "Used when no video is uploaded above. Plays muted, cropped to fill the frame. YouTube may show its title for a moment; for the cleanest loop, upload the video or use Vimeo."
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "Frame the picture",
      "default": true
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Frame",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Line and button"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Line under the picture",
      "default": "Made to order | Circular living | Ethical packaging",
      "info": "Shown in spaced capitals."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "The picture links here too."
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button",
      "default": "#efede9"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#253c30"
    },
    {
      "type": "header",
      "content": "Colours and background"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#253c30"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background picture",
      "info": "Optional. Covers the whole band, under the pattern."
    },
    {
      "type": "checkbox",
      "id": "pattern",
      "label": "Block-print pattern",
      "default": true
    },
    {
      "type": "color",
      "id": "pattern_color",
      "label": "Pattern",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "min": 2,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Pattern strength",
      "default": 6
    },
    {
      "type": "color",
      "id": "ornament_color",
      "label": "Ornament",
      "default": "#e2d1a6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#e2d1a6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and line",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "The heading, picture, line and button rise into place one after another the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Size and spacing"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 36,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 78
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above on phones",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space below on phones",
      "default": 58
    }
  ],
  "blocks": [
    {
      "type": "decoration",
      "name": "Decoration",
      "settings": [
        {
          "type": "paragraph",
          "content": "A picture drawn behind (or in front of) this section, like the reference site's clouds and ribbons. Add as many as you like; delete the block to remove one."
        },
        {
          "type": "select",
          "id": "illustration",
          "label": "Tabi illustration",
          "options": [
            {
              "value": "spray-left",
              "label": "Cotton spray, growing right"
            },
            {
              "value": "spray-right",
              "label": "Cotton spray with bird, growing left"
            },
            {
              "value": "ribbon",
              "label": "Linen ribbon"
            },
            {
              "value": "sprig",
              "label": "Flower sprig"
            },
            {
              "value": "meadow",
              "label": "Meadow border"
            }
          ],
          "default": "spray-left"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Or your own picture",
          "info": "Replaces the illustration above. A PNG or WebP with a transparent background."
        },
        {
          "type": "header",
          "content": "Placement"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-center",
              "label": "Top centre"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "middle-left",
              "label": "Middle left"
            },
            {
              "value": "middle-right",
              "label": "Middle right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom centre"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "top-left"
        },
        {
          "type": "range",
          "id": "offset_x",
          "min": -200,
          "max": 600,
          "step": 10,
          "unit": "px",
          "label": "Distance from the side",
          "default": 0,
          "info": "At desktop size. Below zero it hangs past the edge. For the centre positions, moves it right."
        },
        {
          "type": "range",
          "id": "offset_y",
          "min": -200,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Distance from the top or bottom",
          "default": 0,
          "info": "For the middle positions, moves it down."
        },
        {
          "type": "range",
          "id": "width",
          "min": 40,
          "max": 1440,
          "step": 20,
          "unit": "px",
          "label": "Width on desktop",
          "default": 320,
          "info": "Scales down with the layout on smaller screens."
        },
        {
          "type": "range",
          "id": "width_mobile",
          "min": 0,
          "max": 400,
          "step": 5,
          "unit": "px",
          "label": "Width on phones",
          "default": 100,
          "info": "0 hides it on phones."
        },
        {
          "type": "range",
          "id": "offset_x_mobile",
          "min": -100,
          "max": 300,
          "step": 5,
          "unit": "px",
          "label": "Distance from the side on phones",
          "default": 0
        },
        {
          "type": "range",
          "id": "offset_y_mobile",
          "min": -100,
          "max": 300,
          "step": 5,
          "unit": "px",
          "label": "Distance from the top or bottom on phones",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "flip",
          "label": "Mirror",
          "default": false
        },
        {
          "type": "range",
          "id": "opacity",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Opacity",
          "default": 100
        },
        {
          "type": "select",
          "id": "layer",
          "label": "Layer",
          "options": [
            {
              "value": "back",
              "label": "Behind the content"
            },
            {
              "value": "front",
              "label": "In front of the content"
            }
          ],
          "default": "back"
        },
        {
          "type": "header",
          "content": "Motion"
        },
        {
          "type": "select",
          "id": "animation",
          "label": "Entrance",
          "options": [
            {
              "value": "grow",
              "label": "Grow from its corner"
            },
            {
              "value": "unroll",
              "label": "Unroll left to right"
            },
            {
              "value": "open",
              "label": "Open from the middle"
            },
            {
              "value": "rise",
              "label": "Rise from below"
            },
            {
              "value": "fade",
              "label": "Fade in"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "grow",
          "info": "Plays once, as it scrolls into view, while the section's \"Animate on scroll\" is on."
        },
        {
          "type": "range",
          "id": "drift",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Drift on scroll",
          "default": 16
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home: Spotlight band"
    }
  ]
}
{% endschema %}
