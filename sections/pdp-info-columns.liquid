{% comment %}
  The product information accordions - fabric, care, shipping, returns and
  anything else a template wants to spell out below the buy box.

  One block is one accordion. It has a heading and some text, and that is the
  whole model: there is no "which column does this belong to" dropdown, no
  nested <details> inside <details>, and no JavaScript deciding which layer is
  interactive at which width. Two columns on desktop and one on mobile is a
  grid-template-columns change, so CSS handles it alone.

  (The earlier version of this section asked for a column number on every row
  and rendered a group accordion wrapping a row accordion, with a custom element
  opening and closing the outer layer at the breakpoint. It matched the mockup
  but it was miserable to set up and the double accordion confused shoppers, so
  both went.)

  A block can take its text from a product metafield instead of typing it, by
  putting the key in `Metafield key`. Those blocks hide themselves on products
  where the metafield is empty, which is what lets one template serve a
  catalogue where only some products document, say, their craft technique.
  Blocks with neither a metafield value nor typed text are skipped, and the
  whole section disappears when nothing survives.
{% endcomment %}

{{ 'product-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    Count what will actually render before opening any markup, so a section
    whose blocks are all metafield-driven and all empty prints nothing at all
    rather than an empty bordered box.
  endcomment
  assign live = 0
  for block in section.blocks
    if block.settings.heading == blank
      continue
    endif
    assign key = block.settings.metafield_key | strip
    if key != blank
      if product.metafields.custom[key] != blank
        assign live = live | plus: 1
      endif
    elsif block.settings.content != blank
      assign live = live | plus: 1
    endif
  endfor

  assign columns = 1
  if section.settings.columns == '2' and live > 1
    assign columns = 2
  endif
-%}

{%- if live > 0 -%}
  <div
    class="pdp-section color-{{ section.settings.color_scheme }}"
    style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="pdp-section__inner">
      {%- if section.settings.heading != blank -%}
        <p class="pdp-eyebrow pdp-info__label">{{ section.settings.heading | escape }}</p>
      {%- endif -%}

      <div class="pdp-info__grid" style="--pdp-info-columns: {{ columns }};">
        {%- assign rendered = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign key = block.settings.metafield_key | strip
            assign field = ''
            assign show = false

            if block.settings.heading != blank
              if key != blank
                assign field = product.metafields.custom[key]
                if field != blank
                  assign show = true
                endif
              elsif block.settings.content != blank
                assign show = true
              endif
            endif
          -%}

          {%- if show -%}
            {%- assign rendered = rendered | plus: 1 -%}
            <details
              class="pdp-info__item"
              {% if section.settings.open_first and rendered == 1 %}open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary>
                <span class="pdp-info__heading">{{ block.settings.heading | escape }}</span>
                {%- render 'pdp-icon', icon: 'caret' -%}
              </summary>
              <div class="pdp-info__content rte">
                {%- if key != blank -%}
                  {%- comment -%}
                    A rich text metafield renders its own HTML when output
                    directly. Every other type is a plain string, which has to be
                    escaped and needs its line breaks turned into markup to
                    survive in an HTML context.
                  {%- endcomment -%}
                  {%- if field.type == 'rich_text_field' -%}
                    {{ field }}
                  {%- else -%}
                    <p>{{ field.value | default: field | escape | newline_to_br }}</p>
                  {%- endif -%}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PDP: Info columns",
  "tag": "section",
  "class": "pdp-section-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add one block per accordion. Give it a heading and some text - that is all that is required."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section label",
      "default": "Product information"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "default": "2",
      "options": [
        { "value": "1", "label": "One" },
        { "value": "2", "label": "Two" }
      ],
      "info": "Always one column on mobile."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first accordion by default",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fabric & composition"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Per-product text (optional)"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Metafield key",
          "info": "Key inside the `custom` namespace, e.g. `craft_technique`. When set, this accordion shows that product metafield instead of the text above, and hides itself on products where the metafield is empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP: Info columns",
      "blocks": [
        { "type": "item", "settings": { "heading": "Fabric & composition" } },
        { "type": "item", "settings": { "heading": "Care instructions" } },
        { "type": "item", "settings": { "heading": "Shipping & delivery" } },
        { "type": "item", "settings": { "heading": "Exchanges & returns" } }
      ]
    }
  ]
}
{% endschema %}
