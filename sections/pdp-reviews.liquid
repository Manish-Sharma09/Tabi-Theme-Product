{% comment %}
  Customer reviews.

  The reviews are theme content, not app data: one block per review, typed in
  the theme editor. That is a deliberate limitation - it means a real review app
  is not being replaced or shadowed here, and when one is installed this section
  comes out in one move rather than needing to be untangled from the buy box.
  Nothing on the page reads from it and nothing writes to it.

  The average is computed from the blocks rather than typed, so the number under
  the stars can never drift from the reviews printed beneath it. `Total review
  count` is separate and optional, for the common case where the section shows
  the best six of two hundred: it changes the "based on N reviews" line only,
  never the average.

  Star rows are one shape drawn twice - five icons at low opacity with five
  more clipped over them to the exact percentage. That gives a true 4.3 out of
  5 rather than one rounded to the nearest half, and needs no half-star artwork.
{% endcomment %}

{{ 'product-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign total = 0
  assign counted = 0

  for block in section.blocks
    if block.settings.text == blank
      continue
    endif
    assign rating = block.settings.rating | plus: 0
    if rating < 1
      continue
    endif
    assign total = total | plus: rating
    assign counted = counted | plus: 1
  endfor

  comment
    Liquid has no float division, so the average is worked out in tenths and
    reassembled as a string. 43 tenths becomes "4.3".
  endcomment
  assign average_text = ''
  assign average_percent = 0
  if counted > 0
    assign tenths = total | times: 10 | divided_by: counted
    assign whole = tenths | divided_by: 10
    assign decimal = tenths | modulo: 10
    assign average_text = whole | append: '.' | append: decimal
    assign average_percent = tenths | times: 2
  endif

  assign shown_count = section.settings.review_count | plus: 0
  if shown_count < counted
    assign shown_count = counted
  endif
-%}

{%- capture star_row -%}
  {%- for i in (1..5) -%}{%- render 'pdp-icon', icon: 'star' -%}{%- endfor -%}
{%- endcapture -%}

{%- if counted > 0 -%}
  <div
    class="pdp-section pdp-reviews color-{{ section.settings.color_scheme }} gradient"
    style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="pdp-section__inner">
      {%- if section.settings.heading != blank -%}
        <p class="pdp-eyebrow pdp-reviews__label">{{ section.settings.heading | escape }}</p>
      {%- endif -%}

      <div class="pdp-reviews__summary">
        <p class="pdp-reviews__average">{{ average_text }}</p>
        <div class="pdp-reviews__summary-detail">
          <span
            class="pdp-stars pdp-stars--large"
            style="--pdp-stars-fill: {{ average_percent }}%;"
            role="img"
            aria-label="{{ average_text }} out of 5"
          >
            <span class="pdp-stars__track" aria-hidden="true">{{ star_row }}</span>
            <span class="pdp-stars__fill" aria-hidden="true">{{ star_row }}</span>
          </span>
          <p class="pdp-reviews__count">
            {%- if shown_count == 1 -%}
              Based on 1 review
            {%- else -%}
              Based on {{ shown_count }} reviews
            {%- endif -%}
          </p>
        </div>
      </div>

      <ul class="pdp-reviews__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign rating = block.settings.rating | plus: 0
            if block.settings.text == blank or rating < 1
              continue
            endif
            assign fill = rating | times: 20
          -%}
          <li class="pdp-reviews__item" {{ block.shopify_attributes }}>
            <span
              class="pdp-stars"
              style="--pdp-stars-fill: {{ fill }}%;"
              role="img"
              aria-label="{{ rating }} out of 5"
            >
              <span class="pdp-stars__track" aria-hidden="true">{{ star_row }}</span>
              <span class="pdp-stars__fill" aria-hidden="true">{{ star_row }}</span>
            </span>

            {%- if block.settings.title != blank -%}
              <p class="pdp-reviews__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}

            <p class="pdp-reviews__text">{{ block.settings.text | escape | newline_to_br }}</p>

            <p class="pdp-reviews__author">
              {{ block.settings.author | default: 'Verified buyer' | escape }}
              {%- if block.settings.verified -%}
                <span class="pdp-reviews__verified">
                  {%- render 'pdp-icon', icon: 'check-circle' -%}
                  <span>Verified purchase</span>
                </span>
              {%- endif -%}
            </p>

            {%- if block.settings.meta != blank -%}
              <p class="pdp-reviews__meta">{{ block.settings.meta | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.note != blank -%}
        <p class="pdp-reviews__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PDP: Reviews",
  "tag": "section",
  "class": "pdp-section-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "One block per review. The average score is calculated from the blocks below, so it always matches what is shown."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section label",
      "default": "What people are saying"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Total review count",
      "info": "Optional. Use when the section shows a selection of a larger number of reviews. Ignored if it is lower than the number of blocks."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": "Reviews are collected from customers after delivery."
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "default": "5",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "2", "label": "2 stars" },
            { "value": "1", "label": "1 star" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "info": "A review with no text is skipped."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Verified buyer"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Detail line",
          "info": "Shown under the name, e.g. \"Bengaluru · Size M\"."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show \"Verified purchase\"",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP: Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
