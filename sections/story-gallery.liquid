          "label": "Two columns"
        },
        {
          "value": "stack",
          "label": "One column"
        }
      ],
      "default": "swipe"
    },
    {
      "type": "select",
      "id": "mobile_in_view",
      "label": "Swipe row: pictures in view",
      "options": [
        {
          "value": "82",
          "label": "One, with the next peeking in"
        },
        {
          "value": "64",
          "label": "One and a half"
        },
        {
          "value": "44",
          "label": "Two, with the next peeking in"
        }
      ],
      "default": "64"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Swipe row: dots under the pictures",
      "default": true
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "The words and the row of pictures rise into place the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Leaf sprig"
    },
    {
      "type": "select",
      "id": "decor",
      "label": "Sprig",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "both",
          "label": "Both sides"
        }
      ],
      "default": "none",
      "info": "A fine line drawing of a branch at the edge of the section, behind the words. On the right it is mirrored."
