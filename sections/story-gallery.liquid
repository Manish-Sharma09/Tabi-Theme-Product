      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Caption size on phones",
      "default": 13
    },
    {
      "type": "header",
      "content": "Phones"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Pictures on phones",
      "options": [
        {
          "value": "swipe",
          "label": "Swipe row"
        },
        {
