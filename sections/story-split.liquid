{%- comment -%}
  STORY SPLIT - a picture beside a heading and text, with an optional
  button or text link. The picture's share of the width, its shape, its
  side and the space beside it are settings. Phones stack the two, words
  first or picture first. A leaf sprig can sit at the section's edge.

  On the About page this is "A lifetime in textiles" beside the artisan
  at his block, with "Meet our artisans". Styles in
  assets/story-sections.css, parts 2, 3, 6 and 10.
{%- endcomment -%}

{{ 'story-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign image = section.settings.image
  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign button_label = section.settings.button_label | strip
  assign anchor = section.settings.anchor | strip | handleize

  assign ratio = section.settings.ratio
  if ratio == 'original'
    if image != blank
      assign ratio = image.aspect_ratio
    else
      assign ratio = '4 / 5'
    endif
  endif

  assign justify_m = 'flex-start'
  if section.settings.text_align_mobile == 'center'
    assign justify_m = 'center'
  endif

  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  comment
    Rendered width of the picture: its share of the 1200px content on wide
    screens, of the window (less the margins) on tablets.
  endcomment
  assign media_px = section.settings.media_share | times: 12
  assign media_vw = section.settings.media_share | times: 0.9
  assign sizes = '(min-width: 1328px) ' | append: media_px | append: 'px, (min-width: 750px) ' | append: media_vw | append: 'vw, calc(100vw - 48px)'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .story-section {
    --story-bg: {{ section.settings.background }};
    --story-heading: {{ section.settings.heading_color }};
    --story-text: {{ section.settings.text_color }};
    --story-accent: {{ section.settings.accent_color }};
    --story-button-bg: {{ section.settings.button_color }};
    --story-button-text: {{ section.settings.background }};
    --story-ratio: {{ ratio }};
    --story-media-share: {{ section.settings.media_share }};
    --story-radius: {{ section.settings.corner_radius }};
    --story-radius-m: {{ section.settings.corner_radius_mobile }};
    --story-align: {{ section.settings.text_align }};
    --story-align-m: {{ section.settings.text_align_mobile }};
    --story-justify-m: {{ justify_m }};
    --story-heading-size: {{ section.settings.heading_size }};
    --story-heading-size-m: {{ section.settings.heading_size_mobile }};
    --story-text-size: {{ section.settings.text_size }};
    --story-text-size-m: {{ section.settings.text_size_mobile }};
    --story-pt: {{ section.settings.padding_top }};
    --story-pb: {{ section.settings.padding_bottom }};
    --story-pt-m: {{ section.settings.padding_top_mobile }};
    --story-pb-m: {{ section.settings.padding_bottom_mobile }};
    --story-split-gap: {{ section.settings.gap }};
    --story-label-weight: {{ section.settings.link_weight }};
    --story-decor-w: {{ section.settings.decor_width }};
    --story-decor-w-m: {{ section.settings.decor_width_mobile }};
    --story-decor-color: {{ section.settings.decor_color }};
  }
{%- endstyle -%}

<div
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
  class="story-section story-split{% if section.settings.image_position == 'right' %} story-split--reverse{% endif %}{% if section.settings.mobile_order == 'text_first' %} story-split--text-first{% endif %}{% if section.settings.text_font == 'heading' %} story-section--serif{% endif %}{% if section.settings.decor != 'none' %} story-section--decor{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  {% render 'story-decor', settings: section.settings %}
  <div class="story-section__inner story-split__inner">
    <div class="story-split__media" data-reveal="rise">
      <span class="story-media story-shape-d-{{ section.settings.shape }} story-shape-m-{{ section.settings.shape_mobile }}">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: sizes,
              loading: loading
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'story-placeholder' }}
        {%- endif -%}
      </span>
      {%- if section.settings.caption != blank -%}
        <span class="story-caption">{{ section.settings.caption | escape }}</span>
      {%- endif -%}
    </div>

    <div class="story-split__copy">
      {%- if eyebrow != blank -%}
        <p class="story-eyebrow" data-reveal="rise" style="--reveal-order: 1;">{{ eyebrow | escape }}</p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="story-heading" data-reveal="rise" style="--reveal-order: 1;">
          {{- heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="story-text" data-reveal="rise" style="--reveal-order: 2;">
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      {%- if button_label != blank -%}
        {%- liquid
          case section.settings.button_style
            when 'filled'
              assign button_class = 'story-button'
            when 'link'
              assign button_class = 'story-link'
            else
              assign button_class = 'story-button story-button--outline'
          endcase
        -%}
        <p
          class="story-actions{% if section.settings.button_style == 'link' %} story-actions--link{% endif %}"
          data-reveal="rise"
          style="--reveal-order: 3; --story-justify: flex-start;"
        >
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="{{ button_class }}"
          >
            {{- button_label | escape -}}
            {%- if section.settings.button_style == 'link' -%}
              <svg viewBox="0 0 16 10" aria-hidden="true" focusable="false"><path d="M0 5h15M11 1l4 4-4 4"/></svg>
            {%- endif -%}
          </a>
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story: Picture and text",
  "tag": "section",
  "class": "story-split-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture",
      "info": "Set a focal point so the crop keeps the subject."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption under the picture",
      "info": "Optional."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Picture",
      "options": [
        {
          "value": "left",
          "label": "Left of the text"
        },
        {
          "value": "right",
          "label": "Right of the text"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "On phones",
      "options": [
        {
          "value": "text_first",
          "label": "Text, then the picture"
        },
        {
          "value": "picture_first",
          "label": "Picture, then the text"
        }
      ],
      "default": "text_first"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Picture shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "2 / 3",
          "label": "Tall portrait (2:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "5 / 4",
          "label": "Landscape (5:4)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "original",
          "label": "As uploaded"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "media_share",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "label": "Picture width on desktop",
      "default": 45
    },
    {
      "type": "range",
      "id": "gap",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Space between picture and text on desktop",
      "default": 96
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Corners on desktop",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        }
      ],
      "default": "rounded"
    },
    {
      "type": "select",
      "id": "shape_mobile",
      "label": "Corners on phones",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "arch",
          "label": "Arch"
        }
      ],
      "default": "rounded"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner roundness on desktop",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner roundness on phones",
      "default": 12
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "info": "Optional. Shown in small capitals."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A lifetime in textiles"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our roots go back decades, to a family garment-making business and a lifetime spent understanding cloth.</p>"
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "Text font",
      "options": [
        {
          "value": "body",
          "label": "Body font (Jost)"
        },
        {
          "value": "heading",
          "label": "Heading font (Cormorant)"
        }
      ],
      "default": "body",
      "info": "The heading font is smaller on its body: set its text sizes about 4px larger."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "info": "Optional."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "outline",
          "label": "Outlined button"
        },
        {
          "value": "filled",
          "label": "Filled button"
        },
        {
          "value": "link",
          "label": "Text link with an arrow"
        }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "link_weight",
      "label": "Text link weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment on phones",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "The picture and words rise into place the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Leaf sprig"
    },
    {
      "type": "select",
      "id": "decor",
      "label": "Sprig",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "both",
          "label": "Both sides"
        }
      ],
      "default": "none",
      "info": "A fine line drawing of a branch at the edge of the section, behind the words. On the right it is mirrored."
    },
    {
      "type": "image_picker",
      "id": "decor_image",
      "label": "Own drawing",
      "info": "Optional. Replaces the line sprig. A transparent PNG or WebP works best."
    },
    {
      "type": "select",
      "id": "decor_position",
      "label": "Sprig height",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "decor_width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Sprig width on desktop",
      "default": 240,
      "info": "Smaller on narrower windows."
    },
    {
      "type": "color",
      "id": "decor_color",
      "label": "Sprig colour",
      "default": "#d9bfa3",
      "info": "For the line sprig."
    },
    {
      "type": "checkbox",
      "id": "decor_mobile",
      "label": "Show the sprig on phones",
      "default": false
    },
    {
      "type": "range",
      "id": "decor_width_mobile",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Sprig width on phones",
      "default": 120
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f9f7f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3d3b37"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Small label",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#253c30",
      "info": "The text link takes the heading colour."
    },
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size on phones",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Text size on desktop",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size on phones",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space above on phones",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space below on phones",
      "default": 56
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Name for links to this section",
      "info": "Optional. A name such as values lets a button jump here: link it to /pages/about#values."
    }
  ],
  "presets": [
    {
      "name": "Story: Picture and text"
    }
  ]
}
{% endschema %}
