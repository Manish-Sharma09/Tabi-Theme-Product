{%- comment -%}
  STORY TEXT - one column of words at a comfortable reading width: a small
  label, a heading, the text, a short line and up to two buttons. The text
  is either the body font ("Regular") or the heading font, larger ("Lead"),
  for an opening or a pull quote. Highlight blocks add a row of icons with
  a title and a line each under the words.

  On the About page this is "A little more meaning in every thread" with
  its three highlights, and the closing "The journey continues" with its
  two buttons. On the Founder's Note it closes the letter with a
  signature: a sign-off line, a scan of the signature, the name and a
  role. Styles in assets/story-sections.css, parts 2, 5, 9 and 11.
{%- endcomment -%}

{{ 'story-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign label_1 = section.settings.button_label_1 | strip
  assign label_2 = section.settings.button_label_2 | strip
  assign anchor = section.settings.anchor | strip | handleize

  case section.settings.width
    when 'narrow'
      assign measure = '560px'
    when 'wide'
      assign measure = '860px'
    else
      assign measure = '680px'
  endcase

  assign justify = 'center'
  if section.settings.text_align == 'left'
    assign justify = 'flex-start'
  elsif section.settings.text_align == 'right'
    assign justify = 'flex-end'
  endif

  assign justify_m = 'center'
  if section.settings.text_align_mobile == 'left'
    assign justify_m = 'flex-start'
  elsif section.settings.text_align_mobile == 'right'
    assign justify_m = 'flex-end'
  endif

  assign reveal_order = 0

  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif

  assign signoff = section.settings.signoff | strip
  assign signature_name = section.settings.signature_name | strip
  assign signature_role = section.settings.signature_role | strip
  assign has_signature = false
  if signoff != blank or signature_name != blank or signature_role != blank or section.settings.signature_image != blank
    assign has_signature = true
  endif

  case section.settings.button_style_1
    when 'outline'
      assign button_1_class = 'story-button story-button--outline'
    when 'link'
      assign button_1_class = 'story-link'
    else
      assign button_1_class = 'story-button'
  endcase
-%}

{%- style -%}
  {%- if section.settings.text_style == 'lead' or section.settings.text_font == 'heading' -%}
    {% render 'story-heading-italic' %}
  {%- endif %}

  #shopify-section-{{ section.id }} .story-section {
    --story-bg: {{ section.settings.background }};
    --story-heading: {{ section.settings.heading_color }};
    --story-text: {{ section.settings.text_color }};
    --story-accent: {{ section.settings.accent_color }};
    --story-button-bg: {{ section.settings.button_color }};
    --story-button-text: {{ section.settings.button_text_color }};
    --story-button-weight: {{ section.settings.button_weight }};
    --story-measure: {{ measure }};
    --story-align: {{ section.settings.text_align }};
    --story-align-m: {{ section.settings.text_align_mobile }};
    --story-justify: {{ justify }};
    --story-justify-m: {{ justify_m }};
    --story-heading-size: {{ section.settings.heading_size }};
    --story-heading-size-m: {{ section.settings.heading_size_mobile }};
    --story-text-size: {{ section.settings.text_size }};
    --story-text-size-m: {{ section.settings.text_size_mobile }};
    --story-lead-size: {{ section.settings.lead_size }};
    --story-lead-size-m: {{ section.settings.lead_size_mobile }};
    --story-pt: {{ section.settings.padding_top }};
    --story-pb: {{ section.settings.padding_bottom }};
    --story-pt-m: {{ section.settings.padding_top_mobile }};
    --story-pb-m: {{ section.settings.padding_bottom_mobile }};
    --story-mark: {{ section.settings.mark_color }};
    --story-button-px: {{ section.settings.button_padding }};
    --story-label-weight: {{ section.settings.label_weight }};
    --story-hl-cols: {{ section.blocks.size | at_least: 1 }};
    --story-icon-size: {{ section.settings.icon_size }};
    --story-hl-size: {{ section.settings.highlight_text_size }};
    --story-hl-size-m: {{ section.settings.highlight_text_size_mobile }};
    --story-signature-w: {{ section.settings.signature_width }};
    --story-signature-name: {{ section.settings.signature_name_size }};
    --story-signature-name-m: {{ section.settings.signature_name_size_mobile }};
    {%- render 'story-palette', palette: section.settings.palette %}
  }
{%- endstyle -%}

<div
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
  class="story-section story-text-section{% if section.settings.text_font == 'heading' %} story-section--serif{% endif %}{% if section.settings.heading_breaks_mobile == false %} story-section--m-flow{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  <div class="story-section__inner">
    <div class="story-column">
      {%- if eyebrow != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <p class="story-eyebrow" data-reveal="rise" style="--reveal-order: {{ reveal_order }};">
          {{- eyebrow | escape -}}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <{{ heading_tag }} class="story-heading" data-reveal="rise" style="--reveal-order: {{ reveal_order }};">
          {{- heading | escape | newline_to_br -}}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <div
          class="story-text{% if section.settings.text_style == 'lead' %} story-text--lead{% endif %}"
          data-reveal="rise"
          style="--reveal-order: {{ reveal_order }};"
        >
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      {%- if has_signature -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <div class="story-signature" data-reveal="rise" style="--reveal-order: {{ reveal_order }};">
          {%- if signoff != blank -%}
            <p class="story-text story-signature__signoff">{{ signoff | escape }}</p>
          {%- endif -%}
          {%- if section.settings.signature_image != blank -%}
            {%- liquid
              assign signature_alt = section.settings.signature_image.alt | strip
              if signature_alt == blank and signature_name != blank
                assign signature_alt = 'Signature of ' | append: signature_name
              endif
              assign signature_px = section.settings.signature_width | append: 'px'
            -%}
            <span class="story-signature__image">
              {{-
                section.settings.signature_image
                | image_url: width: 800
                | image_tag: widths: '200, 400, 600, 800', sizes: signature_px, loading: 'lazy', alt: signature_alt
              -}}
            </span>
          {%- endif -%}
          {%- if signature_name != blank or signature_role != blank -%}
            <p class="story-signature__who">
              {%- if signature_name != blank -%}
                <span class="story-signature__name">{{ signature_name | escape }}</span>
              {%- endif -%}
              {%- if signature_role != blank -%}
                <span class="story-signature__role">{{ signature_role | escape }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_rule -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <div class="story-rule-row" aria-hidden="true" data-reveal="fade" style="--reveal-order: {{ reveal_order }};">
          <span class="story-rule"></span>
        </div>
      {%- endif -%}

      {%- if label_1 != blank or label_2 != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <p
          class="story-actions{% if section.settings.button_style_1 == 'link' %} story-actions--link{% endif %}"
          data-reveal="rise"
          style="--reveal-order: {{ reveal_order }};"
        >
          {%- if label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="{{ button_1_class }}"
            >
              {{- label_1 | escape -}}
              {%- if section.settings.button_style_1 == 'link' -%}
                <svg viewBox="0 0 16 10" aria-hidden="true" focusable="false"><path d="M0 5h15M11 1l4 4-4 4"/></svg>
              {%- endif -%}
            </a>
          {%- endif -%}
          {%- if label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="story-button story-button--outline"
            >
              {{- label_2 | escape -}}
            </a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul
        class="story-highlights story-highlights--m-{{ section.settings.highlights_mobile }}{% if section.settings.highlight_lines %} story-highlights--lines{% endif %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign hl_title = block.settings.title | strip
            assign hl_text = block.settings.text | strip
          -%}
          <li
            class="story-highlight"
            data-reveal="rise"
            style="--reveal-order: {{ reveal_order | plus: forloop.index }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon_image != blank -%}
              <span class="story-highlight__icon">
                {{- block.settings.icon_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '56px', loading: 'lazy', alt: '' -}}
              </span>
            {%- elsif block.settings.icon != 'none' -%}
              <span class="story-highlight__icon">
                {%- render 'story-icon', icon: block.settings.icon -%}
              </span>
            {%- endif -%}
            {%- if hl_title != blank -%}
              <h3 class="story-label">{{ hl_title | escape }}</h3>
            {%- endif -%}
            {%- if hl_text != blank -%}
              <p class="story-highlight__text">{{ hl_text | escape | newline_to_br }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Story: Text",
  "tag": "section",
  "class": "story-text-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "info": "Optional. Shown in small capitals."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The journey continues",
      "info": "Each new line starts a new line on the page."
    },
    {
      "type": "checkbox",
      "id": "heading_breaks_mobile",
      "label": "Keep the heading's line breaks on phones",
      "default": true,
      "info": "Untick when a long first line leaves a short word alone on phones; the heading then wraps evenly."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tabi takes its name from the Japanese word for <em>journey</em>.</p><p>For now, we're glad you're here.</p>"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "options": [
        {
          "value": "body",
          "label": "Regular"
        },
        {
          "value": "lead",
          "label": "Lead (heading font, larger)"
        }
      ],
      "default": "body",
      "info": "\"Lead\" suits an opening or a quote of a few lines."
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "Text font",
      "options": [
        {
          "value": "body",
          "label": "Body font (Jost)"
        },
        {
          "value": "heading",
          "label": "Heading font (Cormorant)"
        }
      ],
      "default": "body",
      "info": "The heading font is smaller on its body: set its text sizes about 4px larger."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Column width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment on phones",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Short line under the text",
      "default": false
    },
    {
      "type": "header",
      "content": "Highlights"
    },
    {
      "type": "paragraph",
      "content": "Add Highlight blocks for a row of icons under the words, each with a title and a line of text."
    },
    {
      "type": "checkbox",
      "id": "highlight_lines",
      "label": "Fine lines between highlights",
      "default": true
    },
    {
      "type": "select",
      "id": "highlights_mobile",
      "label": "Highlights on phones",
      "options": [
        {
          "value": "stack",
          "label": "One under another"
        },
        {
          "value": "row",
          "label": "In a row"
        }
      ],
      "default": "stack"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Highlight title weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "highlight_text_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Highlight text size on desktop",
      "default": 15
    },
    {
      "type": "range",
      "id": "highlight_text_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Highlight text size on phones",
      "default": 14
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button",
      "info": "Leave empty for no button."
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "label": "First button style",
      "options": [
        {
          "value": "filled",
          "label": "Filled button"
        },
        {
          "value": "outline",
          "label": "Outlined button"
        },
        {
          "value": "link",
          "label": "Text link with an arrow"
        }
      ],
      "default": "filled"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button",
      "info": "Outlined. Leave empty for no button."
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button colour",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text on the filled button",
      "default": "#f9f7f4"
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Button text weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "button_padding",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Space either side of the button text",
      "default": 28
    },
    {
      "type": "header",
      "content": "Signature"
    },
    {
      "type": "paragraph",
      "content": "Closes a letter under the text. Leave all of these empty for no signature."
    },
    {
      "type": "text",
      "id": "signoff",
      "label": "Sign-off line",
      "info": "For example: With warmth,"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature",
      "info": "A scan of the signature. A PNG with a see-through background sits best on any colour."
    },
    {
      "type": "range",
      "id": "signature_width",
      "min": 80,
      "max": 360,
      "step": 10,
      "unit": "px",
      "label": "Signature width",
      "default": 200,
      "info": "Phones show it a little smaller."
    },
    {
      "type": "text",
      "id": "signature_name",
      "label": "Name"
    },
    {
      "type": "text",
      "id": "signature_role",
      "label": "Role",
      "info": "Shown in small capitals under the name."
    },
    {
      "type": "range",
      "id": "signature_name_size",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Name size on desktop",
      "default": 30
    },
    {
      "type": "range",
      "id": "signature_name_size_mobile",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Name size on phones",
      "default": 26
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "The words rise into place the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Colour set",
      "options": [
        {
          "value": "light",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "green",
          "label": "Tabi green"
        },
        {
          "value": "custom",
          "label": "Custom - the colours below"
        }
      ],
      "default": "custom",
      "info": "Off-white, sand and Tabi green (as on the home page) set the background, headings, text, labels and buttons together, in colours that read on it. Custom uses the colours below."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f9f7f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and lead text",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3d3b37"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Small label",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "mark_color",
      "label": "Icons and short line",
      "default": "#c46a50"
    },
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size on phones",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Regular text size on desktop",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Regular text size on phones",
      "default": 16
    },
    {
      "type": "range",
      "id": "lead_size",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Lead text size on desktop",
      "default": 26
    },
    {
      "type": "range",
      "id": "lead_size_mobile",
      "min": 16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Lead text size on phones",
      "default": 21
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space above on phones",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space below on phones",
      "default": 56
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Name for links to this section",
      "info": "Optional. A name such as values lets a button jump here: link it to /pages/about#values."
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
