{%- comment -%}
  STORY TEXT - one column of words at a comfortable reading width: a small
  label, a heading, the text, a short line and up to two buttons. The text
  is either the body font ("Regular") or the heading font, larger ("Lead"),
  for an opening or a pull quote. Highlight blocks add a row of icons with
  a title and a line each under the words; a leaf sprig and a few words at
  the side can frame the section.

  On the About page this is "A little more meaning in every thread" with
  its three highlights, and the closing "The journey continues" with its
  two buttons. Styles in assets/story-sections.css, parts 2, 5, 9 and 10.
{%- endcomment -%}

{{ 'story-sections.css' | asset_url | stylesheet_tag }}
{{ 'tabi-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabi-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign label_1 = section.settings.button_label_1 | strip
  assign label_2 = section.settings.button_label_2 | strip
  assign side_words = section.settings.side_words | strip
  assign anchor = section.settings.anchor | strip | handleize

  case section.settings.width
    when 'narrow'
      assign measure = '560px'
    when 'wide'
      assign measure = '860px'
    else
      assign measure = '680px'
  endcase

  assign justify = 'center'
  if section.settings.text_align == 'left'
    assign justify = 'flex-start'
  elsif section.settings.text_align == 'right'
    assign justify = 'flex-end'
  endif

  assign justify_m = 'center'
  if section.settings.text_align_mobile == 'left'
    assign justify_m = 'flex-start'
  elsif section.settings.text_align_mobile == 'right'
    assign justify_m = 'flex-end'
  endif

  assign reveal_order = 0
-%}

{%- style -%}
  {%- if section.settings.text_style == 'lead' or section.settings.text_font == 'heading' -%}
    {% render 'story-heading-italic' %}
  {%- endif %}

  #shopify-section-{{ section.id }} .story-section {
    --story-bg: {{ section.settings.background }};
    --story-heading: {{ section.settings.heading_color }};
    --story-text: {{ section.settings.text_color }};
    --story-accent: {{ section.settings.accent_color }};
    --story-button-bg: {{ section.settings.button_color }};
    --story-button-text: {{ section.settings.button_text_color }};
    --story-button-weight: {{ section.settings.button_weight }};
    --story-measure: {{ measure }};
    --story-align: {{ section.settings.text_align }};
    --story-align-m: {{ section.settings.text_align_mobile }};
    --story-justify: {{ justify }};
    --story-justify-m: {{ justify_m }};
    --story-heading-size: {{ section.settings.heading_size }};
    --story-heading-size-m: {{ section.settings.heading_size_mobile }};
    --story-text-size: {{ section.settings.text_size }};
    --story-text-size-m: {{ section.settings.text_size_mobile }};
    --story-lead-size: {{ section.settings.lead_size }};
    --story-lead-size-m: {{ section.settings.lead_size_mobile }};
    --story-pt: {{ section.settings.padding_top }};
    --story-pb: {{ section.settings.padding_bottom }};
    --story-pt-m: {{ section.settings.padding_top_mobile }};
    --story-pb-m: {{ section.settings.padding_bottom_mobile }};
    --story-mark: {{ section.settings.mark_color }};
    --story-button-px: {{ section.settings.button_padding }};
    --story-label-weight: {{ section.settings.label_weight }};
    --story-hl-cols: {{ section.blocks.size | at_least: 1 }};
    --story-icon-size: {{ section.settings.icon_size }};
    --story-hl-size: {{ section.settings.highlight_text_size }};
    --story-hl-size-m: {{ section.settings.highlight_text_size_mobile }};
    --story-aside-color: {{ section.settings.side_color }};
    --story-decor-w: {{ section.settings.decor_width }};
    --story-decor-w-m: {{ section.settings.decor_width_mobile }};
    --story-decor-color: {{ section.settings.decor_color }};
  }
{%- endstyle -%}

<div
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
  class="story-section story-text-section{% if section.settings.text_font == 'heading' %} story-section--serif{% endif %}{% if section.settings.decor != 'none' %} story-section--decor{% endif %}"
  {% if section.settings.motion %}
    data-motion
  {% endif %}
>
  {% render 'story-decor', settings: section.settings %}
  <div class="story-section__inner">
    <div class="story-column">
      {%- if eyebrow != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <p class="story-eyebrow" data-reveal="rise" style="--reveal-order: {{ reveal_order }};">
          {{- eyebrow | escape -}}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <h2 class="story-heading" data-reveal="rise" style="--reveal-order: {{ reveal_order }};">
          {{- heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <div
          class="story-text{% if section.settings.text_style == 'lead' %} story-text--lead{% endif %}"
          data-reveal="rise"
          style="--reveal-order: {{ reveal_order }};"
        >
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      {%- if section.settings.show_rule -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <div class="story-rule-row" aria-hidden="true" data-reveal="fade" style="--reveal-order: {{ reveal_order }};">
          <span class="story-rule"></span>
        </div>
      {%- endif -%}

      {%- if label_1 != blank or label_2 != blank -%}
        {%- assign reveal_order = reveal_order | plus: 1 -%}
        <p class="story-actions" data-reveal="rise" style="--reveal-order: {{ reveal_order }};">
          {%- if label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="story-button"
            >
              {{- label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="story-button story-button--outline"
            >
              {{- label_2 | escape -}}
            </a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul
        class="story-highlights story-highlights--m-{{ section.settings.highlights_mobile }}{% if section.settings.highlight_lines %} story-highlights--lines{% endif %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign hl_title = block.settings.title | strip
            assign hl_text = block.settings.text | strip
          -%}
          <li
            class="story-highlight"
            data-reveal="rise"
            style="--reveal-order: {{ reveal_order | plus: forloop.index }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon_image != blank -%}
              <span class="story-highlight__icon">
                {{- block.settings.icon_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '56px', loading: 'lazy', alt: '' -}}
              </span>
            {%- elsif block.settings.icon != 'none' -%}
              <span class="story-highlight__icon">
                {%- render 'story-icon', icon: block.settings.icon -%}
              </span>
            {%- endif -%}
            {%- if hl_title != blank -%}
              <h3 class="story-label">{{ hl_title | escape }}</h3>
            {%- endif -%}
            {%- if hl_text != blank -%}
              <p class="story-highlight__text">{{ hl_text | escape | newline_to_br }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if side_words != blank -%}
    <p class="story-aside" aria-hidden="true">{{ side_words | escape | newline_to_br }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Story: Text",
  "tag": "section",
  "class": "story-text-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "info": "Optional. Shown in small capitals."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The journey continues",
      "info": "Each new line starts a new line on the page."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tabi takes its name from the Japanese word for <em>journey</em>.</p><p>For now, we're glad you're here.</p>"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "options": [
        {
          "value": "body",
          "label": "Regular"
        },
        {
          "value": "lead",
          "label": "Lead (heading font, larger)"
        }
      ],
      "default": "body",
      "info": "\"Lead\" suits an opening or a quote of a few lines."
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "Text font",
      "options": [
        {
          "value": "body",
          "label": "Body font (Jost)"
        },
        {
          "value": "heading",
          "label": "Heading font (Cormorant)"
        }
      ],
      "default": "body",
      "info": "The heading font is smaller on its body: set its text sizes about 4px larger."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Column width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment on phones",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Short line under the text",
      "default": false
    },
    {
      "type": "header",
      "content": "Highlights"
    },
    {
      "type": "paragraph",
      "content": "Add Highlight blocks for a row of icons under the words, each with a title and a line of text."
    },
    {
      "type": "checkbox",
      "id": "highlight_lines",
      "label": "Fine lines between highlights",
      "default": true
    },
    {
      "type": "select",
      "id": "highlights_mobile",
      "label": "Highlights on phones",
      "options": [
        {
          "value": "stack",
          "label": "One under another"
        },
        {
          "value": "row",
          "label": "In a row"
        }
      ],
      "default": "stack"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Highlight title weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "highlight_text_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Highlight text size on desktop",
      "default": 15
    },
    {
      "type": "range",
      "id": "highlight_text_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Highlight text size on phones",
      "default": 14
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button",
      "info": "Filled. Leave empty for no button."
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button",
      "info": "Outlined. Leave empty for no button."
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button colour",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text on the filled button",
      "default": "#f9f7f4"
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Button text weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "button_padding",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Space either side of the button text",
      "default": 28
    },
    {
      "type": "header",
      "content": "Leaf sprig"
    },
    {
      "type": "select",
      "id": "decor",
      "label": "Sprig",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "both",
          "label": "Both sides"
        }
      ],
      "default": "none",
      "info": "A fine line drawing of a branch at the edge of the section, behind the words. On the right it is mirrored."
    },
    {
      "type": "image_picker",
      "id": "decor_image",
      "label": "Own drawing",
      "info": "Optional. Replaces the line sprig. A transparent PNG or WebP works best."
    },
    {
      "type": "select",
      "id": "decor_position",
      "label": "Sprig height",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "decor_width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Sprig width on desktop",
      "default": 240,
      "info": "Smaller on narrower windows."
    },
    {
      "type": "color",
      "id": "decor_color",
      "label": "Sprig colour",
      "default": "#d9bfa3",
      "info": "For the line sprig."
    },
    {
      "type": "checkbox",
      "id": "decor_mobile",
      "label": "Show the sprig on phones",
      "default": false
    },
    {
      "type": "range",
      "id": "decor_width_mobile",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Sprig width on phones",
      "default": 120
    },
    {
      "type": "header",
      "content": "Words at the side"
    },
    {
      "type": "textarea",
      "id": "side_words",
      "label": "Words",
      "info": "Optional. Small capitals at the right of the section, level with its foot, one word per line, with a short line under them. Wide screens only."
    },
    {
      "type": "color",
      "id": "side_color",
      "label": "Colour",
      "default": "#c9ae94"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Animate on scroll",
      "default": true,
      "info": "The words rise into place the first time they scroll into view. Off for visitors who ask their device for less motion, and in the theme editor."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f9f7f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and lead text",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3d3b37"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Small label",
      "default": "#253c30"
    },
    {
      "type": "color",
      "id": "mark_color",
      "label": "Icons and short line",
      "default": "#c46a50"
    },
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size on phones",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Regular text size on desktop",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Regular text size on phones",
      "default": 16
    },
    {
      "type": "range",
      "id": "lead_size",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Lead text size on desktop",
      "default": 26
    },
    {
      "type": "range",
      "id": "lead_size_mobile",
      "min": 16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Lead text size on phones",
      "default": 21
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space above on phones",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space below on phones",
      "default": 56
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Name for links to this section",
      "info": "Optional. A name such as values lets a button jump here: link it to /pages/about#values."
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "hands",
              "label": "Hands and heart"
            },
            {
              "value": "infinity",
              "label": "Infinity"
            },
            {
              "value": "needle",
              "label": "Needle and thread"
            },
            {
              "value": "spool",
              "label": "Spool of thread"
            },
            {
              "value": "flower",
              "label": "Flower"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "sun",
              "label": "Sun"
            },
            {
              "value": "recycle",
              "label": "Circle of arrows"
            },
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "drop",
              "label": "Drop"
            },
            {
              "value": "none",
              "label": "No icon"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Own icon",
          "info": "Optional. Replaces the icon above. A square, transparent PNG works best."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Natural fabrics",
          "info": "Shown in small capitals."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Thoughtfully chosen, kind to the planet."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Story: Text"
    }
  ]
}
{% endschema %}
