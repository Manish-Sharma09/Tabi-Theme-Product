{%- comment -%}
  The leaf sprig at the side of a story section: a fine line drawing of a
  branch, or the merchant's own picture in its place. It grows from the
  left edge of the section and is mirrored on the right. Decorative, so it
  is hidden from screen readers; placed by assets/story-sections.css,
  part 10, and shown on phones only when asked.

  Accepts:
  - settings {object}: the section's settings - decor (none | left | right
    | both), decor_image, decor_position (top | middle | bottom),
    decor_mobile

  Usage:
  {% render 'story-decor', settings: section.settings %}
{%- endcomment -%}
{%- liquid
  case settings.decor
    when 'left'
      assign sides = 'left'
    when 'right'
      assign sides = 'right'
    when 'both'
      assign sides = 'left,right'
    else
      assign sides = ''
  endcase
  assign sides = sides | split: ','
-%}
{%- for side in sides -%}
  <span
    class="story-decor story-decor--{{ side }} story-decor--{{ settings.decor_position }}{% if settings.decor_mobile %} story-decor--m{% endif %}"
    aria-hidden="true"
  >
    {%- if settings.decor_image != blank -%}
      {{
        settings.decor_image
        | image_url: width: 800
        | image_tag: widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 360px, 240px', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      <svg viewBox="0 0 240 360" focusable="false"><path d="M8 352C40 250 110 140 214 34M21.2 315Q29.2 292.6 6.3 273.3Q3.6 298.9 21.2 315M21.2 315L11.4 284.7M30.3 293.1Q53.2 294.3 68.9 275.2Q40.3 272.4 30.3 293.1M30.3 293.1L57.6 279.4M40.6 271Q49.6 251 29.9 231.6Q25.5 255 40.6 271M40.6 271L33.8 242.5M52 248.8Q72.9 251.5 88.6 235Q62.5 230.6 52 248.8M52 248.8L78 238.1M64.4 226.5Q74 208.7 57.1 189.7Q51.7 210.9 64.4 226.5M64.4 226.5L60 199.9M77.9 204.1Q96.8 207.9 112.2 193.8Q88.6 188.1 77.9 204.1M77.9 204.1L102.3 196M92.5 181.7Q102.2 166.1 88.1 147.8Q81.8 166.7 92.5 181.7M92.5 181.7L90 157.2M108.1 159.1Q125 163.6 139.7 151.7Q118.7 145.3 108.1 159.1M108.1 159.1L130.6 153.1M124.7 136.6Q134.4 123.1 122.6 105.8Q116 122.5 124.7 136.6M124.7 136.6L123.9 114.5M142.4 114.1Q157.3 119 171.2 109.1Q152.7 102.2 142.4 114.1M142.4 114.1L162.9 109.9M161.2 91.6Q170.4 80 160.8 64.1Q154.1 78.6 161.2 91.6M161.2 91.6L161.5 71.8M180.9 69.1Q193.9 74.2 206.5 66.1Q190.6 59.1 180.9 69.1M180.9 69.1L199.2 66.4M201.7 46.7Q210.3 37.1 202.7 22.6Q196.1 35 201.7 46.7M201.7 46.7L202.9 29.5M214 34Q226.2 30.1 231.6 16Q217.7 21.7 214 34M214 34L226.7 21M62 236C100 214 140 206 196 196M82.8 225.4Q94.2 236.9 111.6 234.3Q97.8 219.3 82.8 225.4M82.8 225.4L103.7 231.2M98.3 219.1Q112.5 213.4 111.9 194.3Q98.5 203.9 98.3 219.1M98.3 219.1L108.6 201.6M114.5 213.7Q123.2 225 138.6 224.7Q128.3 210.1 114.5 213.7M114.5 213.7L132 221.1M131.5 209.1Q144.3 205.4 145.5 188.8Q133.1 195.9 131.5 209.1M131.5 209.1L142 194.8M149.5 204.9Q156.2 215.2 169.4 216Q161.6 202.7 149.5 204.9M149.5 204.9L164.1 212.4M168.8 201Q179.8 198.5 181.6 184.5Q170.7 189.9 168.8 201M168.8 201L178.4 189.4M189.4 197.2Q194.6 206 205.7 207Q199.5 195.7 189.4 197.2M189.4 197.2L201.3 203.9M196 196Q205.7 199.1 215.6 192.5Q204 189.7 196 196M196 196L210.1 193.5M104 152C96 112 100 84 92 44M99.9 123.9Q98 109.9 80.8 106Q86.3 120.2 99.9 123.9M99.9 123.9L86.6 110.6M98.4 105.4Q110.3 100.1 113.2 86.3Q98.1 92.4 98.4 105.4M98.4 105.4L108.6 91.4M97.3 87.3Q96.2 75.4 81.7 71.6Q8