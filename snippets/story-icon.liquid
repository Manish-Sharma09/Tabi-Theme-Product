{%- comment -%}
  Line icons for the story sections' highlights ("Natural fabrics",
  "Crafted by artisans", "Made to last" on the About page). One 24px grid
  and one stroke for the set; the colour comes from currentColor and the
  stroke width from assets/story-sections.css. Decorative: the highlight's
  title says what it means.

  Accepts:
  - icon {string}: leaf | hands | infinity | needle | flower | heart | sun |
    recycle | home | spool | sparkle | drop

  Usage:
  {% render 'story-icon', icon: block.settings.icon %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5.5 18.5C5 11 9.5 5.5 19 5c.6 8.6-4.7 13.9-13.5 13.5Z"/><path d="M5.5 18.5 14.5 9.5M5.5 18.5 4 20"/>
    </svg>
  {%- when 'hands' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 10.1c-1.1-1.5-3.4-1-3.4.7 0 1.4 1.8 2.5 3.4 3.5 1.6-1 3.4-2.1 3.4-3.5 0-1.7-2.3-2.2-3.4-.7Z"/><path d="M12 20.5H9.6c-3 0-5.4-2.4-5.4-5.4V8.6c0-1 1.5-1.2 1.7-.2l.9 4.1M12 20.5h2.4c3 0 5.4-2.4 5.4-5.4V8.6c0-1-1.5-1.2-1.7-.2l-.9 4.1M6.8 12.5c.7 1.9 2.3 3.2 4.2 3.5M17.2 12.5c-.7 1.9-2.3 3.2-4.2 3.5"/>
    </svg>
  {%- when 'infinity' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 12c-1.9-2.5-3.7-3.8-5.5-3.8a3.8 3.8 0 0 0 0 7.6c1.8 0 3.6-1.3 5.5-3.8Zm0 0c1.9 2.5 3.7 3.8 5.5 3.8a3.8 3.8 0 0 0 0-7.6c-1.8 0-3.6 1.3-5.5 3.8Z"/>
    </svg>
  {%- when 'needle' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.5 19.5 17 7l2.2-2.2a1 1 0 0 0-1.4-1.4L15.6 5.6 17 7"/><path d="M18.4 5.6c-4.6.4-9.9 2.6-8.2 5.6 1.3 2.3 6.4.5 6.8 3.2.5 3.3-6.4 4.6-11 3.3"/>
    </svg>
  {%- when 'flower' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="2.2"/><path d="M12 9.8C10.5 7.6 10.6 4.5 12 3.5c1.4 1 1.5 4.1 0 6.3ZM14.1 11.3c1.9-1.8 4.9-2.4 6.1-1.3-.5 1.6-3.4 2.9-6.1 1.3ZM13.3 13.8c2.4 1.1 3.9 3.8 3.4 5.4-1.7.2-3.9-2.1-3.4-5.4ZM10.7 13.8c.5 3.3-1.7 5.6-3.4 5.4-.5-1.6 1-4.3 3.4-5.4ZM9.9 11.3c-2.7 1.6-5.6.3-6.1-1.3 1.2-1.1 4.2-.5 6.1 1.3Z"/>
    </svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 19.5s-7.5-4.4-7.5-10A4.1 4.1 0 0 1 12 7.2a4.1 4.1 0 0 1 7.5 2.3c0 5.6-7.5 10-7.5 10Z"/>
    </svg>
  {%- when 'sun' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="3.8"/><path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M5.6 18.4l1.6-1.6M16.8 7.2l1.6-1.6"/>
    </svg>
  {%- when 'recycle' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M19.5 12a7.5 7.5 0 0 1-12.8 5.3M4.5 12a7.5 7.5 0 0 1 12.8-5.3M17.6 3.4v3.4h-3.4M6.4 20.6v-3.4h3.4"/>
    </svg>
  {%- when 'home' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.5 10.5 12 4l7.5 6.5M6.5 9v10.5h11V9M10 19.5v-5h4v5"/>
    </svg>
  {%- when 'spool' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6.5 4.5h11M6.5 19.5h11M8 4.5v15M16 4.5v15M8 8l8 2.2M8 11.4l8 2.2M8 14.8l8 2.2"/>
    </svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3.5c.6 4.3 4.2 7.9 8.5 8.5-4.3.6-7.9 4.2-8.5 8.5-.6-4.3-4.2-7.9-8.5-8.5 4.3-.6 7.9-4.2 8.5-8.5Z"/>
    </svg>
  {%- when 'drop' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3.5s6 6.4 6 10.6a6 6 0 0 1-12 0C6 9.9 12 3.5 12 3.5Z"/><path d="M9.2 14.6a2.9 2.9 0 0 0 2.4 2.6"/>
    </svg>
{%- endcase -%}
