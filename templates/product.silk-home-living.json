    "pdp-band-tabi-way": {
      "type": "pdp-feature-band",
      "settings": {
        "image_position": "left",
        "split": "media_narrow",
        "mobile_text_first": true,
        "eyebrow": "The Tabi way",
        "heading": "A journey towards slower, mindful living.",
        "body": "<p>Tabi is a celebration of the everyday journey - yours and ours, together! It is built around the idea that the things we choose to live with can help us live a little more slowly and consciously. All Tabi products are built with love and care for the planet and the people using them, while blending the rich artisanal heritage of Indian handcrafts into everyday pieces.</p>",
        "link_label": "Read more about us",
        "decor_width": 9,
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
